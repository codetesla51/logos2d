// BREAKOUT — brick breaker on the logos2d declarative ECS.
// Ball physics: velocity lives directly in vx/vy (the engine integrates it).
// Walls bounce in ent_on_tick bounds checks; paddle/bricks/pickups via
// collide() rules. fix_vy() guarantees vertical progress so trajectories
// can never go near-horizontal.
//
// Pre-launch: served balls sit on the paddle until SPACE launches them.
// Special bricks (star icon) drop pickups: LASER (balls auto-shoot the
// nearest brick), MULTI (two extra balls), POWER (ball smashes through,
// double damage), COLOR (repaints the balls). Brick layouts are randomized
// every game.

let W = 320              // logical screen (window_width() == 320)
let H = 240
let BALL_BASE = 2.6      // serve speed
let BALL_MAX = 4.2

let state = "menu"       // menu | play | over | win
let score = 0
let lives = 3
let pid = 0              // paddle entity id
let ticks = 0            // frame counter (trail timing)
let gt = 0               // effect clock
let laser_until = 0      // gt timestamps; effect active while gt < *_until
let strong_until = 0
let combo = 0
let level = 1
let auto = cli_flag("auto")    // autopilot bot (also toggled with B)
let auto_wait = 0              // dwell ticks on over/win before auto acts

fn load_font_asset() {
    load_font("kenvector_future.ttf", 12)
}

// ---------------- entities ----------------

fn spawn_paddle() {
    pid = create("paddle", "paddleBlu.png", W / 2, H - 16, table{
        scale: 0.5, w: 50, h: 10
    })
}

// serve attaches a ball to the paddle; SPACE launches it
// serve speed creeps up per level so later levels play faster
fn level_speed() {
    let s = BALL_BASE + (level - 1) * 0.2
    if s > 3.4 {
        s = 3.4
    }
    return s
}

fn serve_ball() {
    let bid = create("ball", "ballGrey.png", ent_get(pid, "x"), H - 34, table{
        scale: 0.5, w: 9, h: 9, spin: 10,
        vx: 0, vy: 0,
        spd: level_speed(),
        attached: true
    })
    ent_on_tick(bid, fn(id) { ball_tick(id) })
}

fn launch(id) {
    ent_set(id, "attached", false)
    let vx = random(-12, 12) / 10.0
    let s = ent_get(id, "spd")
    ent_set(id, "vx", vx)
    ent_set(id, "vy", 0.0 - math_sqrt(s * s - vx * vx))
    play_sound("confirm.ogg")
}

fn ball_tick(id) {
    // pre-launch: ride the paddle until SPACE
    if ent_get(id, "attached") {
        ent_set(id, "x", ent_get(pid, "x"))
        ent_set(id, "y", ent_get(pid, "y") - 13)
        if key_pressed("space") || auto {
            launch(id)
        }
    } else {
        // motion trail: a fading star every other tick while the ball flies
        ticks += 1
        if ticks % 2 == 0 {
            create("fx", "particleStar.png", ent_get(id, "x"), ent_get(id, "y"), table{
                scale: 0.22, ttl: 9, spin: 8
            })
        }
        let x = ent_get(id, "x")
        if x < 8 {
            ent_set(id, "x", 8)
            ent_set(id, "vx", 0.0 - ent_get(id, "vx"))
        } else {
            if x > W - 8 {
                ent_set(id, "x", W - 8)
                ent_set(id, "vx", 0.0 - ent_get(id, "vx"))
            }
        }
        let y = ent_get(id, "y")
        if y < 8 {
            ent_set(id, "y", 8)
            ent_set(id, "vy", 0.0 - ent_get(id, "vy"))
        } else {
            if y > H + 14 {
                lose_ball(id)
            }
        }
    }
}

// fix_vy enforces |vy| >= 30% of speed so trajectories always make
// vertical progress (kills near-horizontal rattling).
fn fix_vy(id) {
    let s = ent_get(id, "spd")
    let vy = ent_get(id, "vy")
    let minv = s * 0.3
    if abs(vy) < minv {
        let sy = 1
        if vy < 0 {
            sy = 0 - 1
        }
        let sx = 1
        if ent_get(id, "vx") < 0 {
            sx = 0 - 1
        }
        ent_set(id, "vy", sy * minv)
        ent_set(id, "vx", sx * math_sqrt(s * s - minv * minv))
    }
}

fn lose_ball(id) {
    kill(id)
    if group_count("ball") == 0 {
        // last ball gone: pay a life, respawn if any remain
        shake(10, 18)
        burst(ent_get(id, "x"), H - 20)
        lives = lives - 1
        if lives <= 0 {
            state = "over"
            auto_wait = 90
            set_world_paused(true)
            play_sound("game_over.ogg")
        } else {
            play_sound("ball_lost.ogg")
            after(40, fn() { serve_ball() })
        }
    } else {
        play_sound("ball_lost.ogg")
    }
}

// ---------------- bricks ----------------

fn burst(x, y) {
    for i in range(0, 4) {
        create("fx", "particleStar.png", x, y, table{
            vx: random(-20, 20) / 10.0, vy: random(-30, -10) / 10.0,
            scale: 0.4, ttl: 22
        })
    }
}

// random layout every game: full/checker/pyramid/gaps + a few random holes
fn layout_places(pat) {
    let cells = []
    for row in range(0, 5) {
        for col in range(0, 10) {
            let place = true
            if pat == 1 {
                if (row + col) % 2 == 1 {
                    place = false
                }
            }
            if pat == 2 {
                if col < row || col > 9 - row {
                    place = false
                }
            }
            if pat == 3 {
                if row % 2 == 1 && col % 2 == 1 {
                    place = false
                }
            }
            if pat == 0 {
                if random(0, 9) == 0 {
                    place = false
                }
            }
            if place {
                cells = push(cells, table{r: row, c: col})
            }
        }
    }
    return cells
}

fn make_brick(cell, kind) {
    let row = cell.r
    let col = cell.c
    let hp = 1
    if row < 2 {
        hp = 2
    }
    let bid = create("bricks", cell.img, 22 + col * 31, 38 + row * 24, table{
        scale: 0.75, w: 22, h: 22,
        hp: hp
    })
    if kind != "" {
        // mark it special + pin a spinning star on it so players can see
        ent_set(bid, "pu", kind)
        let iid = create("fx", "particleStar.png", ent_get(bid, "x"), ent_get(bid, "y"), table{
            scale: 0.32, spin: 5, ttl: -1
        })
        ent_set(bid, "icon", iid)
    }
    on_death(bid, fn(id) {
        burst(ent_get(id, "x"), ent_get(id, "y"))
        shake(2, 5)
        play_sound("brick_break_${random(0, 4)}.ogg")
        combo = combo + 1
        if combo > 5 {
            combo = 5
        }
        score += 25 * combo
        let ic = ent_get(id, "icon")
        if ic {
            kill(ic)
        }
        let k = ent_get(id, "pu")
        if k {
            drop_pickup(ent_get(id, "x"), ent_get(id, "y"), k)
        }
        if group_count("bricks") == 0 {
            state = "win"
            auto_wait = 90
            set_world_paused(true)
            play_sound("win.ogg")
        }    })
}

fn build_bricks() {
    let imgs = ["element_red_square_glossy.png",
                "element_yellow_square_glossy.png",
                "element_green_square_glossy.png",
                "element_blue_square_glossy.png",
                "element_purple_square.png"]
    let cells = layout_places(random(0, 3))
    // deal exactly one pickup to 4 spread-out cells
    let n = len(cells)
    if n > 8 {
        let kinds = ["laser", "multi", "power", "color"]
        let base = random(0, n - 1)
        let step = n / 4
        for i in range(0, 4) {
            let idx = (base + i * step + random(0, 2)) % n
            cells[idx].pu = kinds[i]
        }
    }
    for i in range(0, n) {
        let cell = cells[i]
        let r = cell.r
        cell.img = imgs[r]
        let kind = ""
        if cell.pu {
            kind = cell.pu
        }
        make_brick(cell, kind)
    }
}

// ---------------- pickups ----------------

fn drop_pickup(x, y, kind) {
    let img = "particleStar.png"
    if kind == "laser" {
        img = "pu_rapid.png"
    }
    if kind == "multi" {
        img = "pu_twin.png"
    }
    if kind == "power" {
        img = "pu_rocket.png"
    }
    if kind == "color" {
        img = "pu_color.png"
    }
    create("pickups", img, x, y, table{
        vy: 1.1, spin: 5, scale: 0.3, w: 10, h: 10, kind: kind
    })
}

fn spawn_clone(x, y, vx, vy) {
    let s = math_sqrt(vx * vx + vy * vy)
    let nid = create("ball", "ballGrey.png", x, y, table{
        scale: 0.5, w: 9, h: 9, spin: 10,
        vx: vx, vy: vy, spd: s
    })
    ent_on_tick(nid, fn(id) { ball_tick(id) })
}

// two extra balls, rotated +-40 degrees off a flying one
fn multiball() {
    let ids = group_ids("ball")
    if len(ids) > 0 {
        if len(ids) < 4 {
            // clone a ball that is actually moving, never an attached one
            let b = 0
            for bid in ids {
                if b == 0 {
                    if !ent_get(bid, "attached") {
                        b = bid
                    }
                }
            }
            if b > 0 {
            let vx = ent_get(b, "vx")
            let vy = ent_get(b, "vy")
            let x = ent_get(b, "x") + 6
            let y = ent_get(b, "y") - 6
            let cs = math_cos(0.7)
            let sn = math_sin(0.7)
            spawn_clone(x, y, vx * cs - vy * sn, vx * sn + vy * cs)
            spawn_clone(x, y, vx * cs + vy * sn, 0.0 - vx * sn + vy * cs)
            }
        }
    }
}

fn recolor_balls() {
    let ids = group_ids("ball")
    for bid in ids {
        if random(0, 1) == 0 {
            ent_set(bid, "sprite", "ballBlue.png")
        } else {
            ent_set(bid, "sprite", "ballGrey.png")
        }
    }
}

fn apply_pickup(kind) {
    score += 50
    play_sound("confirm.ogg")
    shake(2, 4)
    if kind == "laser" {
        laser_until = gt + 600
    }
    if kind == "multi" {
        multiball()
    }
    if kind == "power" {
        strong_until = gt + 480
    }
    if kind == "color" {
        recolor_balls()
    }
}

// each ball fires a shot aimed at its nearest brick
fn fire_lasers() {
    let ids = group_ids("ball")
    for bid in ids {
        let bx = ent_get(bid, "x")
        let by = ent_get(bid, "y")
        let tid = nearest("bricks", bx, by)
        if tid > 0 {
            let dx = ent_get(tid, "x") - bx
            let dy = ent_get(tid, "y") - by
            let d = math_sqrt(dx * dx + dy * dy)
            if d > 1 {
                create("bullets", "laser_green.png", bx, by, table{
                    vx: dx / d * 6, vy: dy / d * 6,
                    rot: atan2(dy, dx) + 90,
                    scale: 0.5, w: 4, h: 4, ttl: 60
                })
            }
        }
    }
}

// ---------------- rules ----------------

// start a fresh LEVEL: keeps score/lives, new random layout.
// reset_world clears entities+timers but keeps collide rules.
fn start_level() {
    reset_world()
    laser_until = 0
    strong_until = 0
    combo = 0
    state = "play"
    set_title("BREAKOUT — LEVEL ${level}")
    spawn_paddle()
    build_bricks()
    serve_ball()
    every(24, fn() {
        if laser_until > gt {
            if group_count("bricks") > 0 {
                fire_lasers()
            }
        }
    })
}

// full restart from the menu or after game over
fn start_game() {
    reset_world()
    score = 0
    lives = 3
    level = 1
    start_level()
}

fn register_rules() {
    collide("ball", "paddle", fn(bid, plid) {
        combo = 0
        // deflection by hit offset: center = straight up, edges = steep.
        // Speed is preserved exactly via sqrt(s^2 - vx^2).
        let off = (ent_get(bid, "x") - ent_get(plid, "x")) / 27.0
        if off < -1 {
            off = -1
        }
        if off > 1 {
            off = 1
        }
        let s = ent_get(bid, "spd")
        let vx = off * s * 0.85
        ent_set(bid, "vx", vx)
        ent_set(bid, "vy", 0.0 - math_sqrt(s * s - vx * vx))
        ent_set(bid, "y", ent_get(plid, "y") - 13)
        play_sound("paddle_bounce.ogg")
        invuln_after(bid, 2)
    })
    collide("ball", "bricks", fn(bid, kid) {
        flash(kid, "#ffffff", 4)
        let strong = strong_until > gt
        if strong {
            // smash through: double damage, no bounce
            damage(kid, 2)
        } else {
            damage(kid, 1)
            // reflect on the axis of LEAST penetration (side hit flips vx,
            // top/bottom hit flips vy) so bounces read naturally
            let dx = ent_get(bid, "x") - ent_get(kid, "x")
            let dy = ent_get(bid, "y") - ent_get(kid, "y")
            let ox = 15.5 - abs(dx)
            let oy = 15.5 - abs(dy)
            if ox < oy {
                ent_set(bid, "vx", 0.0 - ent_get(bid, "vx"))
            } else {
                ent_set(bid, "vy", 0.0 - ent_get(bid, "vy"))
            }
            fix_vy(bid)
            // speed creeps up as bricks die, direction ratio preserved
            let old = ent_get(bid, "spd")
            let s = old * 1.03
            if s > BALL_MAX {
                s = BALL_MAX
            }
            if s > old {
                let k = s / old
                ent_set(bid, "vx", ent_get(bid, "vx") * k)
                ent_set(bid, "vy", ent_get(bid, "vy") * k)
                ent_set(bid, "spd", s)
            }
        }
        let hp = ent_get(kid, "hp")
        if hp > 0 {
            // survived the hit (2hp rows): weaker crack, not the break pop
            play_sound("brick_crack.ogg")
        }
        invuln_after(bid, 2)
    })
    collide("paddle", "pickups", fn(plid, uid) {
        let k = ent_get(uid, "kind")
        kill(uid)
        burst(ent_get(uid, "x"), ent_get(uid, "y"))
        apply_pickup(k)
    })
    collide("bullets", "bricks", fn(lid, kid) {
        flash(kid, "#ffffff", 4)
        damage(kid, 1)
        kill(lid)
        score += 10
    })
}

// ---------------- input + ui ----------------

fn steer_paddle() {
    let x = ent_get(pid, "x")
    if key_down("left") {
        x = x - 3.2
    }
    if key_down("right") {
        x = x + 3.2
    }
    if x < 28 {
        x = 28
    }
    if x > W - 28 {
        x = W - 28
    }
    ent_set(pid, "x", x)
}

fn draw_centered(str, y, c) {
    let x = (W - text_width(str)) / 2
    if x < 4 {
        x = 4
    }
    draw_text(str, x, y, c)
}

// title text with a 1px drop shadow so it pops off the dark background
fn draw_title(str, y, c) {
    let x = (W - text_width(str)) / 2
    if x < 4 {
        x = 4
    }
    draw_text(str, x + 1, y + 1, "#000000")
    draw_text(str, x, y, c)
}

// wrap a string to the logical width and draw each line centered.
// guarantees nothing spills past the left/right edges.
fn draw_wrapped(str, y, c) {
    let words = split(str, " ")
    let line = ""
    let yy = y
    for w in words {
        let trial = line == "" ? w : line + " " + w
        if text_width(trial) > W - 8 && line != "" {
            let lx = (W - text_width(line)) / 2
            if lx < 4 { lx = 4 }
            draw_text(line, lx, yy, c)
            yy = yy + 14
            line = w
        } else {
            line = trial
        }
    }
    if line != "" {
        let lx = (W - text_width(line)) / 2
        if lx < 4 { lx = 4 }
        draw_text(line, lx, yy, c)
    }
}

// blinking prompt: visible ~70% of the time
fn blink() {
    return (gt % 60) < 42
}

fn panel(x, y, w, h) {
    draw_rect(x - 2, y - 2, w + 4, h + 4, "#f1c40f")
    draw_rect(x, y, w, h, "#12161f")
}

fn on_load() {
    load_font_asset()
    play_music("music.ogg")
    preload_sprite("paddleBlu.png")
    preload_sprite("ballGrey.png")
    preload_sprite("particleStar.png")
    preload_sprite("pu_rapid.png")
    preload_sprite("pu_twin.png")
    preload_sprite("pu_rocket.png")
    preload_sprite("pu_color.png")
    preload_sprite("laser_green.png")
    preload_sprite("element_red_square_glossy.png")
    preload_sprite("element_yellow_square_glossy.png")
    preload_sprite("element_green_square_glossy.png")
    preload_sprite("element_blue_square_glossy.png")
    preload_sprite("element_purple_square.png")
    set_title("BREAKOUT — press ENTER")
    register_rules()
}

fn on_update(dt) {
    gt += 1
    if key_pressed("b") {
        auto = !auto
    }
    if state == "play" {
        if auto {
            ai_steer()
        } else {
            steer_paddle()
        }
    } else {
        if auto {
            if state == "menu" {
                start_game()
            } else {
                if auto_wait > 0 {
                    auto_wait = auto_wait - 1
                } else {
                    if state == "win" {
                        level += 1
                        set_world_paused(false)
                        start_level()
                    }
                    if state == "over" {
                        start_game()
                    }
                }
            }
        } else {
            if key_pressed("enter") {
                if state == "win" {
                    // cleared the level: advance, keep score/lives
                    level += 1
                    set_world_paused(false)
                    start_level()
                    play_sound("confirm.ogg")
                } else {
                    set_world_paused(false)
                    start_game()
                    play_sound("confirm.ogg")
                }
            }
        }
    }
}

// ---------------- autopilot bot ----------------
// Mirrors the VOID RUNNER demo bot: a brain that reads the world through
// group_ids + ent_get and drives the paddle. Toggle with B, or launch the
// game with `./logos2d demo/breakout/main.lgs -auto`.

// predict the x where a flying ball will cross the paddle line, folding
// horizontal wall bounces into [8, W-8].
fn ai_predict_x(id) {
    let x = ent_get(id, "x")
    let y = ent_get(id, "y")
    let vx = ent_get(id, "vx")
    let vy = ent_get(id, "vy")
    let py = ent_get(pid, "y") - 13
    if vy <= 0 {
        return x
    }
    let t = (py - y) / vy
    if t < 0 {
        return x
    }
    let ex = x + vx * t
    let lo = 8
    let hi = W - 8
    let span = hi - lo
    let period = span * 2
    let p = ex - lo
    for i in range(0, 16, 1) {
        if p < 0 {
            p = 0 - p
        }
        if p > period {
            p = p - period
        }
    }
    if p > span {
        p = period - p
    }
    return lo + p
}

// x-centroid of the remaining bricks; -1 if none (nothing to aim at)
fn brick_centroid_x() {
    let ids = group_ids("bricks")
    let n = len(ids)
    if n == 0 {
        return -1.0
    }
    let sx = 0.0
    for id in ids {
        sx = sx + ent_get(id, "x")
    }
    return sx / (n * 1.0)
}

// steer the paddle under the lowest (closest) ball's predicted landing x.
// When the ball is low and descending, bias the catch point so the bounce
// is aimed at the brick cluster — otherwise a single ball loops one column
// and the board never finishes.
fn ai_steer() {
    let best = -1
    let best_y = -9999.0
    for bid in group_ids("ball") {
        let by = ent_get(bid, "y")
        if by > best_y {
            best_y = by
            best = bid
        }
    }
    // a falling pickup entering the catch zone
    let want_pu = -1
    let wpu_y = -9999.0
    for p in group_ids("pickups") {
        let py = ent_get(p, "y")
        let pv = ent_get(p, "vy")
        if pv > 0 && py > 120 && py > wpu_y {
            wpu_y = py
            want_pu = p
        }
    }
    // don't chase a pickup if the ball is low and in danger of being missed
    let danger = false
    if best >= 0 {
        danger = best_y > 150 && ent_get(best, "vy") > 0
    }
    let target = ent_get(pid, "x")
    if want_pu >= 0 && !danger {
        // go grab it
        target = ent_get(want_pu, "x")
    } else if best >= 0 {
        let bx = ent_get(best, "x")
        let by = ent_get(best, "y")
        let vy = ent_get(best, "vy")
        target = ai_predict_x(best)
        if by > H - 52 && vy > 0 {
            let tx = brick_centroid_x()
            if tx >= 0 {
                let want = (tx - bx) / 60.0
                if want > 1 { want = 1 }
                if want < -1 { want = -1 }
                target = bx - want * 24
            }
        }
    }
    let px = ent_get(pid, "x")
    let d = target - px
    let step = 3.2
    if d > 1 {
        px = px + step
    } else {
        if d < -1 {
            px = px - step
        } else {
            px = target
        }
    }
    if px < 28 { px = 28 }
    if px > W - 28 { px = W - 28 }
    ent_set(pid, "x", px)
}

fn on_draw_back() {
    draw_rect(0, 0, W, H, "#10141c")
}

fn secs_left(until) {
    let left = until - gt
    if left < 0 {
        left = 0
    }
    return left / 60
}

fn any_attached() {
    let ids = group_ids("ball")
    let out = false
    for bid in ids {
        if ent_get(bid, "attached") {
            out = true
        }
    }
    return out
}

fn on_draw_front() {
    if state == "play" || state == "over" || state == "win" {
        let lv = "LEVEL ${level}"
        draw_text(lv, (W - text_width(lv)) / 2, 8, "#7fdbff")
        draw_text("SCORE ${score}", 8, 8, "#e8ecf2")
        if combo > 1 {
            draw_text("COMBO x${combo}", 8, 22, "#f1c40f")
        }
        let lv = "LIVES ${lives}"
        draw_text(lv, W - text_width(lv) - 8, 8, "#e8ecf2")
        // active-effect badges on the second row (below LEVEL) so they
        // never collide with the centered LEVEL text
        if laser_until > gt {
            draw_text("LASER ${secs_left(laser_until)}", 116, 20, "#2ecc71")
        }
        if strong_until > gt {
            draw_text("POWER ${secs_left(strong_until)}", 192, 20, "#e67e22")
        }
        if any_attached() {
            draw_centered("SPACE TO LAUNCH", H - 40, "#7fdbff")
        }
        if auto {
            draw_text("AUTO", W - text_width("AUTO") - 8, 36, "#f1c40f")
        }
    }
    if state == "menu" {
        panel(40, 70, 240, 112)
        draw_title("BREAKOUT", 86, "#f1c40f")
        draw_centered("a logos2d brick-breaker", 104, "#7f8fa3")
        if blink() {
            draw_centered("PRESS ENTER TO PLAY", 138, "#e8ecf2")
        }
        draw_wrapped("MOVE:  ← →     LAUNCH:  SPACE     CATCH THE FALLING POWER-UPS", 172, "#9fb3c8")
    }
    if state == "over" {
        panel(60, 80, 200, 80)
        draw_title("GAME OVER", 96, "#e74c3c")
        draw_centered("SCORE ${score}", 118, "#e8ecf2")
        if blink() {
            draw_centered("ENTER TO RETRY", 140, "#e8ecf2")
        }
    }
    if state == "win" {
        panel(60, 76, 200, 88)
        draw_title("LEVEL ${level} CLEAR!", 92, "#2ecc71")
        draw_centered("SCORE ${score}", 116, "#e8ecf2")
        if blink() {
            draw_centered("ENTER FOR LEVEL ${level + 1}", 138, "#e8ecf2")
        }
    }
}
