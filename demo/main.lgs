// ============================================================
// VOID RUNNER — declarative edition (demo2)
// Same game as demo/, but the script owns NO arrays, NO movement
// loops, NO collision boxes, NO entity drawing. The engine's ECS
// runs the world; this file is only rules + personality.
// Move: A/D or arrows   Fire: SPACE (or B for autopilot)   P pause  M music
// Run: ./logos2d demo2/main.lgs [-auto]
// ============================================================

// ---------------- constants ----------------
const W = 320
const H = 240

const COOLDOWN_BLUE = 8
const COOLDOWN_RAPID = 5
const COOLDOWN_TWIN = 9
const COOLDOWN_ROCKET = 32
const WEAPON_DURATION = 600

const METEOR_INTERVAL_START = 90
const METEOR_INTERVAL_MIN = 40

const PTS_METEOR = 20
const PTS_SHIP = 15
const METEOR_INTERVAL_START = 90
const METEOR_INTERVAL_MIN = 40
const BOSS_SCORE = 1200      // reach this and the VOID RUNNER shows up
const BOSS_HP = 50

// ---------------- state (rules only — no world arrays!) ----------------
let state = "menu"        // menu | play | pause | over
let hp = 3
let score = 0
let kills = 0
let blink_t = 0
let pvx = 0.0              // player velocity X (inertia-based movement)
let frame_t = 0
let cooldown = 0
let weapon = "blue"
let weapon_t = 0
let shield_t = 0
let combo = 0            // current kill-streak multiplier
let combo_t = 0          // ticks left before the streak resets
let music_on = true
let over_t = 0
let spawn_t = 30
let ship_armed = 240     // ticks until the first enemy wave (don't spawn instantly)
let boss_spawned = false // has the climactic boss appeared yet?
let pid = 0               // the player entity id
let stars_far = []
let stars_near = []
let decor_far = []        // parallax world decor (stations, buildings)
let booms = []            // visual-only juice (not gameplay entities)
let parts = []
let auto = cli_flag("auto")
let bot_target = -1000.0

fn filter(arr, pred) {
    let out = []
    for x in arr {
        if pred(x) {
            out = push(out, x)
        }
    }
    return out
}

fn init_stars() {
    stars_far = []
    stars_near = []
    decor_far = []
    for i in range(0, 36, 1) {
        let s = table{x: random(0, W), y: random(0, H)}
        stars_far = push(stars_far, s)
    }
    for i in range(0, 22, 1) {
        let s = table{x: random(0, W), y: random(0, H)}
        stars_near = push(stars_near, s)
    }
    // seed a couple of distant decor props so the world never feels empty
    for i in range(0, 3, 1) {
        decor_far = push(decor_far, spawn_decor_props())
    }
}

fn spawn_decor_props() {
    let roll = random(1, 3)
    let img = "station_small.png"
    if roll == 2 {
        img = "station_big.png"
    }
    if roll == 3 {
        img = "bldg_b.png"
    }
    let sc = 0.18 + random(0, 14) / 100.0
    return table{img: img, x: random(0, W), y: random(0, H), sc: sc, drift: 0.18 + random(0, 6) / 100.0}
}

fn burst(x, y, n, c) {
    for i in range(0, n, 1) {
        let ang = random(0, 359) * 3.14159 / 180.0
        let sp = random(6, 26) / 10.0
        let p = table{
            x: x, y: y,
            vx: math_cos(ang) * sp, vy: math_sin(ang) * sp,
            t: 0, c: c
        }
        parts = push(parts, p)
    }
}

fn boom_at(x, y) { booms = push(booms, table{x: x, y: y, t: 0}) }

fn explode_at(x, y, color) {
    boom_at(x, y)
    burst(x, y, 10, color)
    play_sound("explosion.wav")
}

fn rocket_boom(x, y) {
    boom_at(x, y)
    burst(x, y, 14, "#ff8800")
    shake(5, 8)
    play_sound("explosion.wav")
}

fn drop_powerup(x, y) {
    // never flood the screen — at most 2 powerups live at once
    if group_count("powerups") < 2 {
    let roll = random(1, 5)
    let kind = "rapid"
    if roll == 2 {
        kind = "twin"
    }
    if roll == 3 {
        kind = "shield"
    }
    if roll == 4 {
        kind = "heart"
    }
    if roll == 5 {
        kind = "rocket"
    }
    let spr = "pu_" + kind + ".png"
    if kind == "rocket" {
        spr = "pu_rocket.png"
    }
    create("powerups", spr, x, y, table{vy: 1.2, scale: 0.5, w: 18, h: 18, kind: kind})
    }
}

// ---------------- lifecycle ----------------

fn start_game() {
    reset_world()
    hp = 3
    score = 0
    kills = 0
    blink_t = 0
    pvx = 0.0
    cooldown = 0
    spawn_t = 30
    ship_armed = 240
    boss_spawned = false
    weapon = "blue"
    weapon_t = 0
    shield_t = 0
    combo = 0
    combo_t = 0
    booms = []
    parts = []
    init_stars()
    // the player is just another entity — spawned last so it draws on top
    pid = create("player", "player.png", 160, 212, table{scale: 0.22, w: 20, h: 16})
    over_t = 0
    stop_music()
    play_music("music.ogg")
    music_on = true
    set_world_paused(false)
    state = "play"
}

fn on_load() {
    preload_sprite("player.png")
    preload_sprite("meteor.png")
    preload_sprite("bullet.png")
    preload_sprite("laser_green.png")
    preload_sprite("laser_red.png")
    preload_sprite("shield.png")
    preload_sprite("pu_rapid.png")
    preload_sprite("pu_twin.png")
    preload_sprite("pu_shield.png")
    preload_sprite("pu_heart.png")
    preload_sprite("pu_rocket.png")
    preload_sprite("meteor_brown.png")
    preload_sprite("meteor_gray.png")
    preload_sprite("meteor_red.png")
    preload_sprite("meteor_white.png")
    preload_sprite("eship_red.png")
    preload_sprite("eship_blue.png")
    preload_sprite("eship_green.png")
    preload_sprite("station_big.png")
    preload_sprite("bldg_b.png")
    preload_sprite("rocket.png")
    play_music("music.ogg")
    music_on = true
    init_stars()
    register_rules()
    print("game loaded (declarative)")
}

// ALL interaction rules of the game, declared once.
fn register_rules() {
    // bullets shred meteors (2 hp, knockback, sparks, drops)
    collide("bullets", "meteors", fn(b, m) {
        kill(b)
        burst(ent_get(b, "x"), ent_get(b, "y") + 10, 3, "#f1c40f")
        knockback(m, ent_get(b, "x"), ent_get(b, "y"), 2.0)
        let died = damage(m, 1)
        if died {
            if random(1, 3) == 1 {
                drop_powerup(ent_get(m, "x") + 10, ent_get(m, "y"))
            }
        } else {
            flash(m, "#ffffff", 5)
        }
    })

    // bullets chip the ship's 3 HP (flash on each hit); dies on the 3rd
    collide("bullets", "ships", fn(b, e) {
        kill(b)
        flash(e, "#ffffff", 5)
        damage(e, 1)
    })

    // bullets can shoot down enemy lasers mid-air
    collide("bullets", "ebullets", fn(b, eb) {
        kill(b)
        kill(eb)
        burst(ent_get(eb, "x"), ent_get(eb, "y"), 3, "#ff2222")
    })

    // everything that hurts the player
    collide("meteors", "player", fn(m, p) {
        explode_at(ent_get(m, "x") + 10, ent_get(m, "y") + 10, "#a07050")
        kill(m)
        hurt_player()
    })
    collide("ships", "player", fn(e, p) {
        explode_at(ent_get(e, "x"), ent_get(e, "y"), "#e74c3c")
        kill(e)
        hurt_player()
    })
    collide("ebullets", "player", fn(eb, p) {
        kill(eb)
        burst(ent_get(eb, "x"), ent_get(eb, "y"), 6, "#ff2222")
        hurt_player()
    })

    // powerups get collected
    collide("powerups", "player", fn(pu, p) {
        apply_powerup(ent_get(pu, "kind"))
        kill(pu)
    })

    // rockets: heavy splash vs the small fry, solid punch vs bosses
    collide("rockets", "meteors", fn(r, m) {
        rocket_boom(ent_get(r, "x"), ent_get(r, "y"))
        area_damage(ent_get(r, "x"), ent_get(r, "y"), 26, 99, "meteors")
        area_damage(ent_get(r, "x"), ent_get(r, "y"), 26, 99, "ships")
        kill(r)
    })
    collide("rockets", "ships", fn(r, s) {
        rocket_boom(ent_get(r, "x"), ent_get(r, "y"))
        area_damage(ent_get(r, "x"), ent_get(r, "y"), 26, 99, "meteors")
        area_damage(ent_get(r, "x"), ent_get(r, "y"), 26, 2, "ships")
        kill(r)
    })

    // ===== the VOID RUNNER boss =====
    collide("bullets", "boss", fn(b, e) {
        kill(b)
        flash(e, "#ffffff", 4)
        damage(e, 1)
    })
    collide("rockets", "boss", fn(r, e) {
        rocket_boom(ent_get(r, "x"), ent_get(r, "y"))
        area_damage(ent_get(r, "x"), ent_get(r, "y"), 30, 12, "boss")
        area_damage(ent_get(r, "x"), ent_get(r, "y"), 26, 99, "meteors")
        area_damage(ent_get(r, "x"), ent_get(r, "y"), 26, 99, "ships")
        kill(r)
    })
    collide("boss", "player", fn(e, p) {
        hurt_player()
        flash(e, "#ff5555", 6)
    })

    // survival trickle
    every(60, fn() {
        if state == "play" {
            score += 5
        }
    })

    // steady power-up trickle so they always show up (still capped at 2)
    every(420, fn() {
        if state == "play" {
            drop_powerup(random(40, W - 40), 24)
        }
    })
}

fn hurt_player() {
    // engine skips collide pairs while the player is invulnerable, so this
    // debounce is authoritative — no global counter needed
    invuln_after(pid, 60)
    blink_t = 60
    if shield_t > 0 {
        play_sound("shield_down.wav")
        return 0
    }
    hp -= 1
    shake(8, 8)
    play_sound("hurt.wav")
    return 0
}

fn apply_powerup(kind) {
    play_sound("powerup.wav")
    if kind == "shield" {
        shield_t = 360
        play_sound("shield_up.wav")
    }
    if kind == "rapid" {
        weapon = "green"
        weapon_t = WEAPON_DURATION
    }
    if kind == "twin" {
        weapon = "red"
        weapon_t = WEAPON_DURATION
    }
    if kind == "heart" {
        if hp < 3 {
            hp += 1
        }
        score += 25
    }
    if kind == "rocket" {
        weapon = "rocket"
        weapon_t = WEAPON_DURATION
    }
}

// ---------------- per-frame rules ----------------

fn on_update(dt) {
    frame_t += 1

    if key_pressed("m") {
        if music_on {
            stop_music()
            music_on = false
        } else {
            play_music("music.ogg")
            music_on = true
        }
    }

    scroll_stars()

    if state == "menu" {
        set_world_paused(true)
        if key_pressed("enter") || mouse_pressed("left") || key_pressed("space") || auto {
            start_game()
        }
        return 0
    }

    if state == "pause" {
        set_world_paused(true)
        if key_pressed("p") {
            state = "play"
            set_world_paused(false)
        }
        return 0
    }

    if state == "over" {
        over_t += 1
        set_world_paused(true)
        if key_pressed("enter") || (auto && over_t > 150) {
            start_game()
            play_sound("powerup.wav")
        }
        return 0
    }

    if state == "win" {
        over_t += 1
        set_world_paused(true)
        update_fx()
        if key_pressed("enter") || (auto && over_t > 150) {
            start_game()
            play_sound("powerup.wav")
        }
        return 0
    }

    // ======== play ========
    if key_pressed("p") {
        state = "pause"
        return 0
    }
    if key_pressed("b") {
        auto = !auto
    }

    steer_player()
    update_weapon_timers()

    // spawner: ramps up slowly, and we HARD-CAP how many are live at once
    // so the screen never floods with a wall of rocks
    spawn_t -= 1
    if spawn_t <= 0 {
        if group_count("meteors") < 6 {
            spawn_meteor()
        }
        let iv = METEOR_INTERVAL_START - frame_t / 200
        if iv < METEOR_INTERVAL_MIN {
            iv = METEOR_INTERVAL_MIN
        }
        spawn_t = iv
    }

    // the climactic boss appears once you've scored enough AND survived a
    // while — and it takes over the field (no more normal ship waves)
    if !boss_spawned && score >= BOSS_SCORE && frame_t >= 3600 {
        spawn_boss()
    }

    // enemy spaceships: drop in from the top (1-2 at a time), NEVER instantly,
    // and the waves get tighter + a touch larger as difficulty climbs
    if group_count("boss") == 0 {
        let d = diff()
        let cap = 3
        if d > 1.6 {
            cap = 4
        }
        let live = group_count("ships")
        if frame_t >= ship_armed && live < cap {
            let n = 1
            if random(1, 3) == 1 {
                n = 2
            }
            if live + n > cap {
                n = cap - live
            }
            for i in range(0, n, 1) {
                spawn_ship()
            }
            // hold off the next wave — but less long the harder it gets
            ship_armed = frame_t + (360 + random(0, 360)) / d
        }
    }

    update_fx()

    if hp <= 0 {
        state = "over"
        over_t = 0
        stop_music()
        play_sound("lose.wav")
        print("GAME OVER - score ${score}")
    }
}

fn steer_player() {
    // NOTE: player movement is 100% manual here and we deliberately do NOT
    // set vx on the player entity — simulate() would move it a second time.
    // Instead we keep our own pvx and feed it inertia + banking tilt.
    let ax = 0.0
    if auto {
        ax = bot_acc()
    } else {
        let dir = 0
        if key_down("right") || key_down("d") {
            dir = 1
        }
        if key_down("left") || key_down("a") {
            dir = -1
        }
        ax = dir * 0.5
    }
    // inertia: builds speed gradually, friction bleeds it off when idle
    pvx = pvx * 0.85 + ax
    if pvx > 2.8 {
        pvx = 2.8
    }
    if pvx < -2.8 {
        pvx = -2.8
    }

    // clamp inside walls
    let nx = ent_get(pid, "x") + pvx
    if nx < 8 {
        nx = 8
        pvx = 0
    }
    if nx > W - 8 {
        nx = W - 8
        pvx = 0
    }
    ent_set(pid, "x", nx)

    // banking tilt: nose leans into the turn
    let bank = pvx * 7.0
    if bank > 20 {
        bank = 20
    }
    if bank < -20 {
        bank = -20
    }
    ent_set(pid, "rot", bank)

    if blink_t > 0 {
        blink_t -= 1
        ent_set(pid, "hidden", frame_t % 8 >= 5)
    } else {
        ent_set(pid, "hidden", false)
    }

    if cooldown > 0 {
        cooldown -= 1
    }
    let want_fire = false
    if auto {
        want_fire = bot_should_shoot()
    } else {
        want_fire = key_down("space") || mouse_down("left")
    }
    if want_fire && cooldown <= 0 {
        shoot()
    }
}

fn shoot() {
    let bx = ent_get(pid, "x")
    let img = "bullet.png"
    if weapon == "green" {
        img = "laser_green.png"
        cooldown = COOLDOWN_RAPID
    }
    if weapon == "red" {
        img = "laser_red.png"
        cooldown = COOLDOWN_TWIN
        create("bullets", "laser_red.png", bx - 5, 200, table{vy: -6, scale: 0.3, w: 4, h: 10})
    }
    if weapon == "rocket" {
        cooldown = COOLDOWN_ROCKET
        create("rockets", "rocket.png", bx, 200, table{vy: -2.6, scale: 0.05, rot: 0, w: 8, h: 14})
        play_sound("shoot.wav")
        burst(bx, 196, 3, "#ffaa55")
        return 0
    }
    if weapon == "blue" {
        cooldown = COOLDOWN_BLUE
    }
    create("bullets", img, bx, 200, table{vy: -6, scale: 0.3, w: 4, h: 10})
    play_sound("shoot.wav")
    burst(bx, 196, 2, "#ffffff")
}

fn update_weapon_timers() {
    if weapon_t > 0 {
        weapon_t -= 1
        if weapon_t == 0 && weapon != "blue" {
            weapon = "blue"
        }
    }
    if shield_t > 0 {
        shield_t -= 1
        if shield_t == 0 {
            play_sound("shield_down.wav")
        }
    }
}

// difficulty ramps slowly with survival time — ships fire faster and waves
// come more often the longer you last
fn diff() {
    let d = 1.0 + frame_t / 6000.0
    if d > 2.2 {
        d = 2.2
    }
    return d
}

// every kill feeds the combo: faster kills = bigger multiplier (capped)
fn score_kill(base, x, y) {
    combo += 1
    if combo > 9 {
        combo = 9
    }
    combo_t = 150
    kills += 1
    score += base * combo
    burst(x, y, combo > 1 ? 4 : 2, "#f1c40f")
}

// ---------------- spawning ----------------

// ---------------- declarative behavior trees ----------------

// run_behavior(id, node) — tiny behavior-tree interpreter, pure Logos.
// Call from ent_on_tick every tick; dispatches to nearest()/seek().
//   condition node: table{cond: "hp_below" | "player_near", val: N,
//                         "then": <node>, "else": <node>}
//   action node:    table{type: "chase" | "flee", spd: F, y: F}
// "then"/"else" are QUOTED keys: else is a reserved keyword in Logos, so
// bare `else:` / `.else` won't parse — read them with node["else"] etc.
// "then" may be a condition node (recurses) or an action node.
// Optional action fields: spd (default 2.0), y = fixed altitude line
// (hover height instead of tracking the player's y).
fn run_behavior(id, node) {
    // action nodes have no cond — dispatch by which field is present
    if node.type {
        run_action(id, node)
    } else {
        let ok = false
        // NOTE: missing fields read as NULL and NULL == "x" is a type
        // error, so truthiness-guard a field before comparing it
        if node.cond {
            if node.cond == "hp_below" {
                if node.val {
                    ok = ent_get(id, "hp") < node.val
                }
            } else {
                if node.cond == "player_near" {
                    if node.val {
                        let tid = nearest("player", ent_get(id, "x"), ent_get(id, "y"))
                        ok = distance(ent_get(id, "x"), ent_get(id, "y"), ent_get(tid, "x"), ent_get(tid, "y")) < node.val
                    }
                }
            }
        }
        if ok {
            if node["then"] {
                run_behavior(id, node["then"])
            }
        } else {
            if node["else"] {
                run_behavior(id, node["else"])
            }
        }
    }
}

fn run_action(id, act) {
    let x = ent_get(id, "x")
    let y = ent_get(id, "y")
    let tid = nearest("player", x, y)
    let px = ent_get(tid, "x")
    let py = ent_get(tid, "y")
    let spd = 2.0
    if act.spd {
        spd = act.spd
    }
    let alt = 0.0
    if act.y {
        alt = act.y
    }
    if act.type == "chase" {
        let ty = py
        if alt > 0 {
            ty = alt
        }
        seek(id, px, ty, spd)
    } else {
        if act.type == "flee" {
            // mirror point away from the player, clamped on-screen
            let fx = x + (x - px) * 2.0
            let fy = y + (y - py) * 2.0
            if alt > 0 {
                fy = alt
            }
            if fx < 14 {
                fx = 14
            }
            if fx > W - 14 {
                fx = W - 14
            }
            if fy < 20 {
                fy = 20
            }
            if fy > H - 20 {
                fy = H - 20
            }
            seek(id, fx, fy, spd)
        }
    }
}

fn spawn_meteor() {
    // scales are size-normalized so every variant reads ~20px on screen
    // (meteor.png is 43px; brown/gray/red/white are ~215px each)
    let roll = random(1, 5)
    let img = "meteor.png"
    let sc = 0.46
    if roll == 2 {
        img = "meteor_brown.png"
        sc = 0.093
    }
    if roll == 3 {
        img = "meteor_gray.png"
        sc = 0.094
    }
    if roll == 4 {
        img = "meteor_red.png"
        sc = 0.093
    }
    if roll == 5 {
        img = "meteor_white.png"
        sc = 0.091
    }
    sc = sc + sc * random(0, 6) / 100.0
    let mid = create("meteors", img, random(8, W - 30), -30, table{
              vx: random(-8, 8) / 10.0,
              vy: random(8, 16) / 10.0,
              rot: random(0, 359),
              spin: random(-3, 3),
              scale: sc,
              hp: 2,
              w: 22, h: 22
          })
    on_death(mid, fn(id) {
        explode_at(ent_get(id, "x") + 10, ent_get(id, "y") + 10, "#a07050")
        score_kill(PTS_METEOR, ent_get(id, "x") + 10, ent_get(id, "y") + 10)
    })
}

fn spawn_ship() {
    // each ship is its OWN personality with its own brain — they don't all
    // behave the same.
    //   red   = GUNNER  : patient, slides to line up on you, aimed shots
    //   blue  = WEAVER  : restless, patrols back & forth on its OWN, sprays
    //   green = HUNTER  : aggressive, homes in hard and leads its shots
    let roll = random(1, 3)
    let img = "eship_red.png"
    let ssc = 0.34
    let kind = "gunner"
    let fire = 90
    let hy = 40 + random(0, 70)
    let bw = 34
    let bh = 32
    if roll == 2 {
        img = "eship_blue.png"
        ssc = 0.25
        kind = "weaver"
        fire = 70
        hy = 30 + random(0, 50)
        bh = 22
    }
    if roll == 3 {
        img = "eship_green.png"
        ssc = 0.198
        kind = "hunter"
        fire = 55
        hy = 55 + random(0, 60)
        bh = 30
    }
    let sx = random(20, W - 20)
    // ramp difficulty: later ships fire faster
    let d = diff()
    fire = fire / d
    let sid = create("ships", img, sx, -24, table{
              vx: 0, vy: 0, rot: 0,
              scale: ssc,
              w: bw, h: bh,
              hp: 3, max_hp: 3,
              kind: kind,
              hover: hy,
              fire: fire,
              phase: random(0, 100) / 10.0,
              strafe: (random(0, 1) == 0 ? -1 : 1),
              shoot_t: 30 + random(0, 40)
          })
    ent_on_tick(sid, fn(id) {
        let kind = ent_get(id, "kind")
        let x = ent_get(id, "x")
        let y = ent_get(id, "y")
        let hy = ent_get(id, "hover")
        let ph = ent_get(id, "phase")
        let tid = nearest("player", x, y)
        let px = ent_get(tid, "x")
        if kind == "weaver" {
            // patrol its own sine wave — seek chases the moving point
            let tx = (W / 2) + math_sin(frame_t / 90.0 + ph) * (W / 2 - 20)
            if tx < 14 {
                tx = 14
            }
            if tx > W - 14 {
                tx = W - 14
            }
            // gentle bob baked into the chased point once on station
            let ty = hy
            if y >= hy - 0.5 {
                ty = hy + math_sin(frame_t / 40.0 + ph) * 5.0
            }
            seek(id, tx, ty, 2.0)
        } else {
            if kind == "hunter" {
                // aggressive homing; breaks off when badly wounded
                run_behavior(id, table{cond: "hp_below", val: 2, "then": table{type: "flee", spd: 2.4}, "else": table{type: "chase", spd: 2.6, y: hy}})
            } else {
                // patient gunner; panics and flees if you get too close
                run_behavior(id, table{cond: "player_near", val: 80, "then": table{type: "flee", spd: 1.6}, "else": table{type: "chase", spd: 1.1, y: hy}})
            }
        }
        let st = ent_get(id, "shoot_t") - 1
        if st <= 0 {
            let aim = 0.0
            if kind == "gunner" {
                aim = (px - x) * 0.02
            }
            if kind == "hunter" {
                aim = (px - x) * 0.04
            }
            if kind == "weaver" {
                aim = (random(0, 1) == 0 ? -1 : 1) * random(0, 10) / 10.0
            }
            if aim > 1.8 {
                aim = 1.8
            }
            if aim < -1.8 {
                aim = -1.8
            }
            let vy = 3.0
            if kind == "hunter" {
                vy = 3.6
            }
            vy = vy * diff()
            if vy > 7.0 {
                vy = 7.0
            }
            create("ebullets", "laser_red.png", ent_get(id, "x"), ent_get(id, "y") + 10, table{vx: aim, vy: vy, rot: 180, scale: 0.35, w: 3, h: 8})
            play_sound("efire.wav")
            st = ent_get(id, "fire") + random(0, 30)
        }
        ent_set(id, "shoot_t", st)
    })
    on_death(sid, fn(id) {
        explode_at(ent_get(id, "x"), ent_get(id, "y"), "#e74c3c")
        score_kill(PTS_SHIP, ent_get(id, "x"), ent_get(id, "y"))
        shake(6, 8)
        if random(1, 4) == 1 {
            drop_powerup(ent_get(id, "x"), ent_get(id, "y"))
        }
    })
}

fn spawn_boss() {
    boss_spawned = true
    let bid = create("boss", "eship_green.png", W / 2, -70, table{
              vx: 0, vy: 0, rot: 0,
              scale: 0.78,
              w: 130, h: 110,
              hp: BOSS_HP, max_hp: BOSS_HP,
              shoot_t: 90
          })
    hp_bar(bid, 0, -64, 84)
    ent_on_tick(bid, fn(id) {
        // boss steering is pure AI too: chase the sweeping point; seek
        // handles both the entry glide and the side-to-side patrol
        let hy = 54
        let nx = (W / 2) + math_sin(frame_t / 55.0) * (W / 2 - 55)
        seek(id, nx, hy, 4.0)
        let hpnow = ent_get(id, "hp")
        let enraged = hpnow < BOSS_HP / 2
        let st = ent_get(id, "shoot_t") - 1
        if st <= 0 {
            let x = ent_get(id, "x")
            let y2 = ent_get(id, "y")
            let px = ent_get(pid, "x")
            let aim = (px - x) * 0.02
            if aim > 1.4 {
                aim = 1.4
            }
            if aim < -1.4 {
                aim = -1.4
            }
            // aimed shot down the player's column
            create("ebullets", "laser_red.png", x, y2 + 24, table{vx: aim, vy: 3.2, rot: 180, scale: 0.42, w: 4, h: 9})
            // enraged: also spit a 3-way spread
            if enraged {
                create("ebullets", "laser_red.png", x - 16, y2 + 24, table{vx: aim - 0.7, vy: 3.2, rot: 180, scale: 0.42, w: 4, h: 9})
                create("ebullets", "laser_red.png", x + 16, y2 + 24, table{vx: aim + 0.7, vy: 3.2, rot: 180, scale: 0.42, w: 4, h: 9})
            }
            play_sound("efire.wav")
            st = enraged ? 38 : 64
        }
        ent_set(id, "shoot_t", st)
    })
    on_death(bid, fn(id) {
        let x = ent_get(id, "x")
        let y = ent_get(id, "y")
        explode_at(x, y, "#e74c3c")
        shake(12, 28)
        score += 800
        play_sound("powerup.wav")
        state = "win"
        set_world_paused(true)
    })
}

// ---------------- background + juice ----------------

fn scroll_stars() {
    let move = fn(s) {
        s.y = s.y + 1.4
        if s.y > H {
            s.y = 0
            s.x = random(0, W)
        }
        return true
    }
    filter(stars_far, move)
    filter(stars_near, move)
    let move_d = fn(d) {
        d.y = d.y + d.drift
        if d.y > H + 40 {
            // wrap back to the top, keep the same prop (stable parallax loop)
            d.x = random(0, W)
            d.y = -40
        }
        return true
    }
    filter(decor_far, move_d)
}

fn update_fx() {
    if combo_t > 0 {
        combo_t -= 1
        if combo_t == 0 {
            combo = 0
        }
    }
    booms = filter(booms, fn(bx) {
        bx.t = bx.t + 1
        return bx.t < 16
    })
    parts = filter(parts, fn(p) {
        p.x = p.x + p.vx
        p.y = p.y + p.vy
        p.t = p.t + 1
        return p.t < 20
    })
}

// ---------------- rendering hooks ----------------
// back: stars   [engine draws all entities]   front: HUD + juice

fn on_draw_back() {
    draw_rect(0, 0, W, H, "#000000")
    for s in stars_far {
        draw_rect(s.x, s.y, 1, 2, "#445566")
    }
    for s in stars_near {
        draw_rect(s.x, s.y, 2, 3, "#ddeeff")
    }
    // distant world decor: stations + buildings scrolling slowly behind play
    for d in decor_far {
        draw_sprite_ex(d.img, d.x, d.y, d.sc, 0)
    }
}

fn on_draw_front() {
    if state == "menu" {
        set_camera(0, 0)
        draw_text("VOID RUNNER 2.0", 160 - text_width("VOID RUNNER 2.0") / 2, 70, "#ffffff")
        draw_text("declarative edition", 160 - text_width("declarative edition") / 2, 86, "#7fdbff")
        if frame_t % 60 < 40 {
            let t3 = "PRESS ENTER TO START"
            draw_text(t3, 160 - text_width(t3) / 2, 184, "#f1c40f")
        }
        return 0
    }

    // shield bubble follows the player (gently pulsing)
    if shield_t > 0 {
        draw_sprite_ex("shield.png", ent_get(pid, "x"), 212, 0.22 + math_sin(frame_t / 12.0) * 0.02, 0)
    }
    if cooldown > COOLDOWN_BLUE {
        draw_circle(ent_get(pid, "x"), 200, 2, "#f1c40f")
    }

    // juice
    for bx in booms {
        draw_circle(bx.x, bx.y, bx.t, "#e67e22")
        draw_circle(bx.x, bx.y, bx.t / 2, "#f1c40f")
        if bx.t > 8 {
            draw_circle(bx.x, bx.y, bx.t / 3, "#ffffff")
        }
    }
    for p in parts {
        draw_circle(p.x, p.y, (20 - p.t) / 7 + 1, p.c)
    }

    // floating labels above each power-up so they're never ambiguous
    for pu in group_ids("powerups") {
        let k = ent_get(pu, "kind")
        let lbl = "?"
        let c = "#ffffff"
        if k == "rapid" {
            lbl = "RAPID"
            c = "#2ecc71"
        }
        if k == "twin" {
            lbl = "TWIN"
            c = "#e74c3c"
        }
        if k == "shield" {
            lbl = "SHIELD"
            c = "#3498db"
        }
        if k == "heart" {
            lbl = "+LIFE"
            c = "#e74c3c"
        }
        if k == "rocket" {
            lbl = "ROCKET"
            c = "#f39c12"
        }
        let px = ent_get(pu, "x")
        let py = ent_get(pu, "y")
        draw_text(lbl, px - text_width(lbl) / 2, py - 16, c)
    }

    // enemy health bars are attached to the entities themselves now

    draw_hud()

    if state == "pause" {
        draw_box_line("PAUSED", "press P to resume", "#ffffff", "#95a5a6")
    }
    if state == "over" {
        draw_box_line("GAME OVER", "final score: ${score}", "#e74c3c", "#ffffff")
    }
    if state == "win" {
        draw_rect(0, 92, W, 104, "#04060c")
        draw_text("VOID RUNNER DESTROYED", 160 - text_width("VOID RUNNER DESTROYED") / 2, 108, "#2ecc71")
        draw_text("the void goes quiet at last", 160 - text_width("the void goes quiet at last") / 2, 128, "#7fdbff")
        draw_text("FINAL SCORE  ${score}", 160 - text_width("FINAL SCORE  ${score}") / 2, 152, "#f1c40f")
        if frame_t % 60 < 42 {
            draw_text("PRESS ENTER TO RUN AGAIN", 160 - text_width("PRESS ENTER TO RUN AGAIN") / 2, 178, "#ffffff")
        }
    }
}

fn draw_hud() {
    for i in range(0, hp, 1) {
        draw_sprite_ex("life_icon.png", 266 + i * 17, 13, 0.42, 0)
    }
    draw_text("SCORE ${score}", 8, 24, "#ffffff")
    if auto {
        draw_text("AUTO", 8, 38, "#f1c40f")
    }
    if weapon == "green" {
        draw_text("RAPID ${weapon_t / 60}", 312 - text_width("RAPID ${weapon_t / 60}"), 26, "#2ecc71")
    }
    if weapon == "red" {
        draw_text("TWIN ${weapon_t / 60}", 312 - text_width("TWIN ${weapon_t / 60}"), 26, "#e74c3c")
    }
    if weapon == "rocket" {
        draw_text("RCKT ${weapon_t / 60}", 312 - text_width("RCKT ${weapon_t / 60}"), 26, "#f39c12")
    }
    if shield_t > 0 {
        draw_text("SHLD ${shield_t / 60}", 312 - text_width("SHLD ${shield_t / 60}"), 40, "#3498db")
    }
    if combo > 1 {
        draw_text("x${combo} COMBO", 160 - text_width("x${combo} COMBO") / 2, 40, "#f1c40f")
    }
}

fn draw_box_line(l1, l2, c1, c2) {
    draw_rect(55, 88, 210, 72, "#000000")
    draw_text(l1, 160 - text_width(l1) / 2, 104, c1)
    draw_text(l2, 160 - text_width(l2) / 2, 124, c2)
}

// ---------------- demo bot ----------------
// Same brain as demo/: predict threats to the player line, pick safest
// column, dash there, settle with idle sway. Reads the world through
// group_ids + ent_get — no arrays owned here either.

fn bot_should_shoot() {
    let bx = ent_get(pid, "x")
    for m in group_ids("meteors") {
        if abs(ent_get(m, "x") + 10 - bx) < 11 && ent_get(m, "y") > -10 && ent_get(m, "y") < 206 {
            return true
        }
    }
    for e in group_ids("ships") {
        if abs(ent_get(e, "x") - bx) < 11 && ent_get(e, "y") > -10 && ent_get(e, "y") < 206 {
            return true
        }
    }
    return false
}

fn bot_pick() {
    let best_c = ent_get(pid, "x")
    let best_s = -999999.0
    for ci in range(0, 38, 1) {
        let c = 8 + ci * 8
        if c > W - 8 {
            c = W - 8
        }
        let s = 0.0 - abs(c - ent_get(pid, "x")) * 0.06

        for m in group_ids("meteors") {
            let my = ent_get(m, "y")
            let t = (206 - (my + 19)) / ent_get(m, "vy")
            if t > 0 && t < 70 {
                let fx = ent_get(m, "x") + 10 + ent_get(m, "vx") * t
                let near = 25 - abs(fx - c)
                if near > 0 {
                    s -= near * (90.0 - t) / 45.0
                }
            }
        }
        for e in group_ids("ships") {
            // ships hover in the upper field, so line up under them for points
            let near = 18 - abs(ent_get(e, "x") - c)
            if near > 0 && ent_get(e, "y") < 150 {
                s += near * 0.5
            }
        }
        for eb in group_ids("ebullets") {
            let ey = ent_get(eb, "y")
            let t = (206 - (ey + 6)) / 3.2
            if t > 0 && t < 70 {
                let fx = ent_get(eb, "x") + ent_get(eb, "vx") * t
                let near = 17 - abs(fx - c)
                if near > 0 {
                    s -= near * (70.0 - t) / 20.0
                }
            }
        }
        for pu in group_ids("powerups") {
            let pull = 1.5
            let k = ent_get(pu, "kind")
            if k == "shield" && shield_t == 0 {
                pull = 3.0
            }
            if k == "heart" && hp < 3 {
                pull = 3.0
            }
            let near = 16 - abs(ent_get(pu, "x") - c)
            if near > 0 {
                s += near * pull
            }
        }

        if s > best_s {
            best_s = s
            best_c = c
        }
    }
    return best_c
}

fn bot_acc() {
    if frame_t % 4 == 0 || bot_target < -900 {
        bot_target = bot_pick()
    }
    let d = bot_target - ent_get(pid, "x")
    let a = 0.0
    if d > 7 {
        a = 0.5
    }
    if d < -7 {
        a = -0.5
    }
    if a == 0.0 {
        a = math_sin(frame_t / 13.0) * 0.18
    }
    return a
}
