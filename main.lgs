// ============================================================
// ARENA SHOOTER — logos2d demo game (Kenney space-shooter assets)
// Move: WASD/arrows   Aim+Shoot: mouse   Music: M   Quit: ESC
// ============================================================

fn on_load() {
    // decode everything now instead of mid-gameplay
    preload_sprite("stars.png")
    preload_sprite("player.png")
    preload_sprite("enemy.png")
    preload_sprite("bullet.png")
    print("game loaded")
}

// ---------------- state ----------------

let player = table{
    x: 480.0,
    y: 320.0,
    ang: -90.0,   // facing (degrees), follows the mouse
}

let hp = 3
let score = 0
let kills = 0
let inv = 0          // invulnerability frames after taking damage
let over = false     // game over flag
let frame_t = 0      // global tick counter
let spawn_every = 120

let bullets = []
let enemies = []

const WORLD_W = 960
const WORLD_H = 640

// ---------------- helpers ----------------

fn spawn_enemy() {
    // spawn just outside a random arena edge
    let side = random(0, 3)
    let e = table{x: 0.0, y: 0.0, hp: 2, ang: 0.0}
    if side == 0 {
        e.x = random(0, WORLD_W)
        e.y = -20
    }
    if side == 1 {
        e.x = random(0, WORLD_W)
        e.y = WORLD_H + 20
    }
    if side == 2 {
        e.x = -20
        e.y = random(0, WORLD_H)
    }
    if side == 3 {
        e.x = WORLD_W + 20
        e.y = random(0, WORLD_H)
    }
    enemies = push(enemies, e)
}

fn shoot(tx, ty) {
    let px = player.x + 8
    let py = player.y + 8
    let dx = tx - px
    let dy = ty - py
    let d = mathSqrt(dx * dx + dy * dy)
    if d < 1 {
        return 0
    }
    let b = table{
        x: px + dx / d * 14,
        y: py + dy / d * 14,
        vx: dx / d * 6,
        vy: dy / d * 6,
        life: 90
    }
    bullets = push(bullets, b)
    play_sound("shoot.wav")
}

fn reset_game() {
    player.x = 480.0
    player.y = 320.0
    hp = 3
    score = 0
    kills = 0
    inv = 0
    over = false
    spawn_every = 120
    bullets = []
    enemies = []
}

// ---------------- update ----------------

fn on_update(dt) {
    frame_t = frame_t + 1

    if over {
        if key_pressed("enter") {
            reset_game()
        }
        return 0
    }

    // ---- movement ----
    if key_down("right") || key_down("d") {
        player.x = player.x + 2.4
    }
    if key_down("left") || key_down("a") {
        player.x = player.x - 2.4
    }
    if key_down("down") || key_down("s") {
        player.y = player.y + 2.4
    }
    if key_down("up") || key_down("w") {
        player.y = player.y - 2.4
    }

    // keep inside world
    if player.x < 0 { player.x = 0 }
    if player.x > WORLD_W - 16 { player.x = WORLD_W - 16 }
    if player.y < 0 { player.y = 0 }
    if player.y > WORLD_H - 16 { player.y = WORLD_H - 16 }

    // ---- camera follows player, clamped to world ----
    let cx = player.x + 8 - 160
    let cy = player.y + 8 - 120
    if cx < 0 { cx = 0 }
    if cx > WORLD_W - 320 { cx = WORLD_W - 320 }
    if cy < 0 { cy = 0 }
    if cy > WORLD_H - 240 { cy = WORLD_H - 240 }
    set_camera(cx, cy)

    // ---- aim + shoot (mouse in world coords) ----
    let m = mouse_pos()
    let wx = m.x + camera_x()
    let wy = m.y + camera_y()
    player.ang = atan2(wy - (player.y + 8), wx - (player.x + 8))
    if mouse_pressed("left") {
        shoot(wx, wy)
    }

    // ---- music toggle ----
    if key_pressed("m") {
        play_music("music.wav")
    }

    // ---- bullets ----
    let alive_bullets = []
    for b in bullets {
        b.x = b.x + b.vx
        b.y = b.y + b.vy
        b.life = b.life - 1
        let in_world = b.x > -10 && b.x < WORLD_W + 10 && b.y > -10 && b.y < WORLD_H + 10
        if b.life > 0 && in_world {
            alive_bullets = push(alive_bullets, b)
        }
    }
    bullets = alive_bullets

    // ---- enemy spawning (speeds up as you kill) ----
    if frame_t % spawn_every == 0 && !over {
        spawn_enemy()
        if kills > 0 && kills % 5 == 0 && spawn_every > 40 {
            spawn_every = spawn_every - 10
        }
    }

    // ---- enemies chase player ----
    let alive_enemies = []
    for e in enemies {
        let dx = (player.x + 8) - (e.x + 8)
        let dy = (player.y + 8) - (e.y + 8)
        let d = mathSqrt(dx * dx + dy * dy)
        if d > 1 {
            let spd = 0.9
            if d < 200 {
                spd = 1.4
            }
            e.x = e.x + dx / d * spd
            e.y = e.y + dy / d * spd
            e.ang = atan2(dy, dx)
        }
        alive_enemies = push(alive_enemies, e)
    }
    enemies = alive_enemies

    // ---- bullet vs enemy collisions ----
    for b in bullets {
        for e in enemies {
            if rects_overlap(b.x - 2, b.y - 2, 4, 4, e.x + 2, e.y + 2, 12, 12) {
                b.life = 0
                e.hp = e.hp - 1
                score = score + 10
                kills = kills + 1
                play_sound("hit.wav")
            }
        }
    }

    // drop dead enemies
    let survivors = []
    for e in enemies {
        if e.hp > 0 {
            survivors = push(survivors, e)
        }
    }
    enemies = survivors

    // ---- enemy vs player ----
    if inv > 0 {
        inv = inv - 1
    }
    for e in enemies {
        if inv == 0 {
            if rects_overlap(player.x, player.y, 16, 16, e.x + 2, e.y + 2, 12, 12) {
                hp = hp - 1
                inv = 60
                play_sound("hurt.wav")
            }
        }
    }

    // ---- game over check ----
    if hp <= 0 {
        over = true
        stop_music()
        print("GAME OVER - score ${score} - press ENTER to restart")
    }
}

// ---------------- draw ----------------

fn on_draw() {
    draw_sprite("stars.png", 0, 0)

    // arena border
    draw_rect(-2, -2, WORLD_W + 4, 2, "#44607a")
    draw_rect(-2, WORLD_H, WORLD_W + 4, 2, "#44607a")
    draw_rect(-2, 0, 2, WORLD_H + 2, "#44607a")
    draw_rect(WORLD_W, 0, 2, WORLD_H + 2, "#44607a")

    for e in enemies {
        draw_sprite_ex("enemy.png", e.x + 9, e.y + 9, 0.22, e.ang + 90)
    }

    for b in bullets {
        draw_sprite_ex("bullet.png", b.x, b.y, 0.35, atan2(b.vy, b.vx) + 90)
    }

    if inv == 0 || frame_t % 8 < 5 {
        draw_sprite_ex("player.png", player.x + 8, player.y + 8, 0.22, player.ang + 90)
    }

    let m = mouse_pos()
    let wx = m.x + camera_x()
    let wy = m.y + camera_y()
    draw_line(player.x + 8, player.y + 8, wx, wy, "#34495e", 1)

    // ------- HUD (screen space) -------
    set_camera(0, 0)

    // hearts
    let hx = 6
    for i in range(0, hp, 1) {
        draw_circle(hx + i * 14 + 5, 12, 5, "#e74c3c")
    }

    draw_text("SCORE ${score}", 250, 6, "#ffffff")
    draw_text("kills: ${kills}", 250, 18, "#95a5a6")

    if mouse_down("left") {
        draw_circle(m.x, m.y, 4, "#ff00ff")
    }

    if over {
        draw_rect(70, 90, 180, 60, "#000000")
        draw_text("GAME OVER", 118, 108, "#e74c3c")
        draw_text("final score: ${score}", 105, 124, "#ffffff")
        draw_text("press ENTER to restart", 92, 138, "#95a5a6")
    }
}
