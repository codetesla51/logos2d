// ============================================================
// VOID RUNNER — endless space survival
// Move: A/D or arrows   Fire: hold SPACE   Pause: P   Music: M
// Dodge the meteor field, blast rocks for powerups.
// When the UFO warship warps in, dodge its lasers and kill it!
// ============================================================

fn on_load() {
    preload_sprite("background.png")
    preload_sprite("player.png")
    preload_sprite("ufo.png")
    preload_sprite("meteor.png")
    preload_sprite("bullet.png")
    preload_sprite("laser_green.png")
    preload_sprite("laser_red.png")
    preload_sprite("shield.png")
    preload_sprite("pu_rapid.png")
    preload_sprite("pu_twin.png")
    preload_sprite("pu_shield.png")
    preload_sprite("pu_heart.png")
    play_music("music.mp3")
    print("game loaded")
}

// ---------------- state ----------------

let state = "menu"       // menu | play | pause | over

let px = 152.0
let pvx = 0.0
let hp = 3
let score = 0
let kills = 0
let inv = 0
let frame_t = 0
let cooldown = 0
let met_interval = 150   // ticks between meteors (shrinks forever)

let weapon = "blue"
let weapon_t = 0
let shield_t = 0
let music_on = true
let shake_t = 0

// the warship encounter
let foe = table{active: false, x: 160.0, y: 60.0, vx: 0.7, hp: 6, maxhp: 6, shoot_t: 90}
let next_foe_at = 480    // first encounter ~8s in

let bullets = []
let ebullets = []
let meteors = []
let powerups = []
let booms = []
let parts = []

const W = 320
const H = 240

// ---------------- helpers ----------------

fn start_game() {
    px = 152.0
    pvx = 0.0
    hp = 3
    score = 0
    kills = 0
    inv = 0
    cooldown = 0
    met_interval = 150
    weapon = "blue"
    weapon_t = 0
    shield_t = 0
    shake_t = 0
    bullets = []
    ebullets = []
    meteors = []
    powerups = []
    booms = []
    parts = []
    foe.active = false
    foe.x = 160.0
    foe.hp = 6
    foe.maxhp = 6
    next_foe_at = 480
    state = "play"
    play_music("music.mp3")
}

fn shoot() {
    if cooldown > 0 {
        return 0
    }
    let b1 = table{x: px + 8, y: 200.0, img: "bullet.png"}
    if weapon == "green" {
        b1.img = "laser_green.png"
        cooldown = 5
    }
    if weapon == "red" {
        b1.img = "laser_red.png"
        let b2 = table{x: px + 2, y: 200.0, img: "laser_red.png"}
        bullets = push(bullets, b2)
        cooldown = 9
    }
    if weapon == "blue" {
        cooldown = 8
    }
    bullets = push(bullets, b1)
    play_sound("shoot.wav")
}

fn spawn_meteor() {
    let m = table{
        x: random(8, W - 30),
        y: -30,
        spd: random(4, 9) / 10.0,
        vx: random(-8, 8) / 10.0,
        rot: random(0, 359),
        vr: random(-3, 3),
        hp: 2
    }
    meteors = push(meteors, m)
}

fn boom(x, y) {
    let bfx = table{x: x, y: y, t: 0}
    booms = push(booms, bfx)
}

fn burst(x, y, n, c) {
    for i in range(0, n, 1) {
        let ang = random(0, 359) * 3.14159 / 180.0
        let sp = random(6, 26) / 10.0
        let p = table{
            x: x,
            y: y,
            vx: math_cos(ang) * sp,
            vy: math_sin(ang) * sp,
            t: 0,
            c: c
        }
        parts = push(parts, p)
    }
}

fn drop_powerup(x, y) {
    let roll = random(1, 4)
    let kind = "rapid"
    if roll == 2 {
        kind = "twin"
    }
    if roll == 3 {
        kind = "shield"
    }
    if roll == 4 {
        kind = "heart"
    }
    let pu = table{x: x, y: y, kind: kind}
    powerups = push(powerups, pu)
}

// ---------------- update ----------------

fn on_update(dt) {
    frame_t = frame_t + 1

    if key_pressed("m") {
        if music_on {
            stop_music()
            music_on = false
        } else {
            play_music("music.mp3")
            music_on = true
        }
    }

    if state == "menu" {
        if key_pressed("enter") || mouse_pressed("left") || key_pressed("space") {
            start_game()
        }
        return 0
    }

    if state == "pause" {
        if key_pressed("p") {
            state = "play"
        }
        return 0
    }

    if state == "over" {
        if key_pressed("enter") {
            start_game()
            play_sound("powerup.wav")
        }
        return 0
    }

    // ================= PLAY =================

    if key_pressed("p") {
        state = "pause"
        return 0
    }

    // survival trickle: +5 every second alive
    if frame_t % 60 == 0 {
        score = score + 5
    }

    movePlayer()

    if cooldown > 0 {
        cooldown = cooldown - 1
    }
    if key_down("space") || mouse_down("left") {
        shoot()
    }

    if inv > 0 { inv = inv - 1 }
    if weapon_t > 0 {
        weapon_t = weapon_t - 1
        if weapon_t == 0 && weapon != "blue" {
            weapon = "blue"
        }
    }
    if shield_t > 0 {
        shield_t = shield_t - 1
        if shield_t == 0 {
            play_sound("shield_down.wav")
        }
    }
    if shake_t > 0 {
        shake_t = shake_t - 1
    }

    updateMeteors()
    updateFoe()
    updateBullets()
    updatePowerups()
    updateFx()

    handleHits()

    if hp <= 0 {
        state = "over"
        stop_music()
        play_sound("lose.wav")
        print("GAME OVER - score ${score} - press ENTER to restart")
    }
}

fn movePlayer() {
    let acc = 0.0
    if key_down("right") || key_down("d") {
        acc = acc + 0.55
    }
    if key_down("left") || key_down("a") {
        acc = acc - 0.55
    }
    pvx = pvx + acc
    if acc == 0.0 {
        pvx = pvx * 0.78
    }
    if pvx > 3.4 { pvx = 3.4 }
    if pvx < -3.4 { pvx = -3.4 }
    px = px + pvx
    if px < 0 { px = 0; pvx = 0 - pvx * 0.4 }
    if px > W - 16 { px = W - 16; pvx = 0 - pvx * 0.4 }
}

fn updateMeteors() {
    // endless field, density ramps with survival time
    met_interval = 210 - frame_t / 200
    if met_interval < 40 {
        met_interval = 40
    }
    if frame_t % met_interval == 0 {
        spawn_meteor()
    }

    let am = []
    for m in meteors {
        m.y = m.y + m.spd
        m.x = m.x + m.vx
        m.rot = m.rot + m.vr
        if m.x < -10 || m.x > W + 10 {
            m.vx = 0 - m.vx
        }
        if m.y < H + 20 {
            am = push(am, m)
        }
    }
    meteors = am
}

fn updateFoe() {
    if !foe.active {
        if frame_t >= next_foe_at {
            foe.active = true
            foe.x = 160.0
            foe.y = 55.0
            foe.vx = 0.7
            // tougher each encounter
            foe.maxhp = 6 + kills / 4
            if foe.maxhp > 20 {
                foe.maxhp = 20
            }
            foe.hp = foe.maxhp
            foe.shoot_t = 80
            print("WARSHIP INCOMING!")
        }
        return 0
    }

    // strafe slowly toward the player's column
    let dx = (px + 8) - foe.x
    if dx > 1 {
        foe.x = foe.x + 0.5
    }
    if dx < -1 {
        foe.x = foe.x - 0.5
    }
    if foe.x < 24 { foe.x = 24 }
    if foe.x > W - 24 { foe.x = W - 24 }

    // bob
    foe.y = 55.0 + math_sin(frame_t / 30.0) * 8.0

    // fire straight down from its position
    foe.shoot_t = foe.shoot_t - 1
    if foe.shoot_t <= 0 {
        let eb = table{x: foe.x, y: foe.y + 12, vx: 0.0, img: "laser_red.png"}
        ebullets = push(ebullets, eb)
        play_sound("hit.wav")
        foe.shoot_t = 42
    }
}

fn updateBullets() {
    let ab = []
    for b in bullets {
        b.y = b.y - 6
        if b.y > -20 {
            ab = push(ab, b)
        }
    }
    bullets = ab

    let aeb = []
    for eb in ebullets {
        eb.y = eb.y + 3.2
        if eb.y < H + 20 {
            aeb = push(aeb, eb)
        }
    }
    ebullets = aeb
}

fn updatePowerups() {
    let ap = []
    for pu in powerups {
        pu.y = pu.y + 1.2
        let caught = rects_overlap(px + 1, 203, 14, 18, pu.x - 5, pu.y - 5, 10, 10)
        if caught {
            play_sound("powerup.wav")
            burst(pu.x, pu.y, 6, "#ff6b81")
            if pu.kind == "rapid" {
                weapon = "green"
                weapon_t = 600
            }
            if pu.kind == "twin" {
                weapon = "red"
                weapon_t = 600
            }
            if pu.kind == "shield" {
                shield_t = 360
                play_sound("shield_up.wav")
            }
            if pu.kind == "heart" {
                if hp < 3 {
                    hp = hp + 1
                }
                score = score + 25
            }
        }
        if pu.y < H - 24 && !caught {
            ap = push(ap, pu)
        }
    }
    powerups = ap
}

fn updateFx() {
    let abo = []
    for bx in booms {
        bx.t = bx.t + 1
        if bx.t < 16 {
            abo = push(abo, bx)
        }
    }
    booms = abo

    let apt = []
    for p in parts {
        p.x = p.x + p.vx
        p.y = p.y + p.vy
        p.t = p.t + 1
        if p.t < 20 {
            apt = push(apt, p)
        }
    }
    parts = apt
}

fn handleHits() {
    // player bullets vs meteors
    for b in bullets {
        for m in meteors {
            if m.hp > 0 {
                if rects_overlap(b.x - 2, b.y - 8, 4, 14, m.x + 1, m.y + 1, 18, 18) {
                    m.hp = m.hp - 1
                    b.y = -100
                    if m.hp <= 0 {
                        score = score + 20
                        kills = kills + 1
                        boom(m.x + 10, m.y + 10)
                        burst(m.x + 10, m.y + 10, 10, "#a07050")
                        play_sound("explosion.wav")
                        if random(1, 6) == 1 {
                            drop_powerup(m.x + 10, m.y)
                        }
                    }
                }
            }
        }
        // player bullets vs warship
        if foe.active {
            if foe.hp > 0 {
                if rects_overlap(b.x - 2, b.y - 8, 4, 14, foe.x - 14, foe.y - 14, 28, 28) {
                    foe.hp = foe.hp - 1
                    b.y = -100
                    play_sound("hit.wav")
                    if foe.hp <= 0 {
                        score = score + 150
                        kills = kills + 1
                        boom(foe.x, foe.y)
                        burst(foe.x, foe.y, 16, "#ff00ff")
                        shake_t = 12
                        play_sound("explosion.wav")
                        drop_powerup(foe.x, foe.y + 10)
                        foe.active = false
                        next_foe_at = frame_t + random(600, 1100)
                    }
                }
            }
        }
    }

    // player bullets can intercept enemy lasers
    for b in bullets {
        for eb in ebullets {
            if rects_overlap(b.x - 2, b.y - 8, 4, 14, eb.x - 2, eb.y - 6, 4, 12) {
                b.y = -100
                eb.y = 999
                burst(eb.x, eb.y, 3, "#ff2222")
            }
        }
    }

    // meteors hitting the player
    let keep_m = []
    for m in meteors {
        let gone = false
        if m.y > H - 18 {
            gone = true
        }
        if rects_overlap(px + 4, 206, 8, 12, m.x + 1, m.y + 1, 18, 18) {
            gone = true
            boom(m.x + 10, m.y + 10)
            burst(m.x + 10, m.y + 10, 10, "#a07050")
            play_sound("explosion.wav")
            if shield_t == 0 {
                hp = hp - 1
                inv = 60
                shake_t = 14
                play_sound("hurt.wav")
            }
        }
        if !gone {
            keep_m = push(keep_m, m)
        }
    }
    meteors = keep_m

    // enemy lasers hitting the player
    let keep_eb = []
    for eb in ebullets {
        let gone = false
        if rects_overlap(px + 4, 206, 8, 12, eb.x - 2, eb.y - 6, 4, 12) {
            gone = true
            burst(eb.x, eb.y, 6, "#ff2222")
            if shield_t == 0 {
                hp = hp - 1
                inv = 60
                shake_t = 14
                play_sound("hurt.wav")
            } else {
                play_sound("shield_down.wav")
            }
        }
        if !gone {
            keep_eb = push(keep_eb, eb)
        }
    }
    ebullets = keep_eb

    // warship body touching the player (rare, but possible)
    if foe.active {
        if rects_overlap(px + 4, 206, 8, 12, foe.x - 13, foe.y - 13, 26, 26) {
            if shield_t == 0 {
                hp = hp - 1
                inv = 60
                shake_t = 14
                play_sound("hurt.wav")
            }
        }
    }
}

// ---------------- draw ----------------

fn on_draw() {
    set_camera(math_sin(frame_t * 93.0) * shake_t * 0.6, math_cos(frame_t * 71.0) * shake_t * 0.6)

    draw_sprite("background.png", 0, 0)

    if state == "menu" {
        menuDraw()
        return 0
    }

    for m in meteors {
        draw_sprite_ex("meteor.png", m.x + 10, m.y + 10, 0.45, m.rot)
    }

    // warship + its life bar
    if foe.active {
        draw_sprite_ex("ufo.png", foe.x, foe.y, 0.38, 180)
        draw_rect(foe.x - 16, foe.y - 22, 32, 4, "#333333")
        let w = foe.hp * 30 / foe.maxhp
        draw_rect(foe.x - 15, foe.y - 21, w, 2, "#e74c3c")
    }

    // enemy lasers
    for eb in ebullets {
        draw_sprite_ex(eb.img, eb.x, eb.y, 0.3, 180)
    }

    // powerups bob gently
    for pu in powerups {
        let pimg = "pu_rapid.png"
        if pu.kind == "twin" {
            pimg = "pu_twin.png"
        }
        if pu.kind == "shield" {
            pimg = "pu_shield.png"
        }
        if pu.kind == "heart" {
            pimg = "pu_heart.png"
        }
        draw_sprite_ex(pimg, pu.x, pu.y + math_sin(frame_t / 9.0 + pu.x) * 2.0, 0.45, 0)
    }

    for b in bullets {
        draw_sprite_ex(b.img, b.x, b.y, 0.3, 0)
    }

    if inv == 0 || frame_t % 8 < 5 {
        draw_sprite_ex("player.png", px + 8, 212, 0.22, 0)
    }
    if cooldown > 5 {
        draw_circle(px + 8, 200, 2, "#f1c40f")
    }
    if shield_t > 0 {
        draw_sprite_ex("shield.png", px + 8, 212, 0.22, 0)
    }

    for bx in booms {
        let r = bx.t
        draw_circle(bx.x, bx.y, r, "#e67e22")
        draw_circle(bx.x, bx.y, r / 2, "#f1c40f")
        if bx.t > 8 {
            draw_circle(bx.x, bx.y, r / 3, "#ffffff")
        }
    }

    for p in parts {
        let r = (20 - p.t) / 7
        draw_circle(p.x, p.y, r + 1, p.c)
    }

    // ------- HUD -------
    set_camera(0, 0)

    for i in range(0, hp, 1) {
        draw_sprite_ex("life_icon.png", 266 + i * 17, 13, 0.42, 0)
    }
    draw_text("SCORE ${score}", 8, 24, "#ffffff")

    let wx = 312
    if weapon == "green" {
        let l = "RAPID ${weapon_t / 60}"
        draw_text(l, wx - text_width(l), 26, "#2ecc71")
    }
    if weapon == "red" {
        let l = "TWIN ${weapon_t / 60}"
        draw_text(l, wx - text_width(l), 26, "#e74c3c")
    }
    if shield_t > 0 {
        let l = "SHLD ${shield_t / 60}"
        draw_text(l, wx - text_width(l), 40, "#3498db")
    }

    if state == "pause" {
        draw_rect(85, 100, 150, 44, "#000000")
        let l = "PAUSED"
        draw_text(l, 160 - text_width(l) / 2, 116, "#ffffff")
        let l2 = "press P to resume"
        draw_text(l2, 160 - text_width(l2) / 2, 132, "#95a5a6")
    }

    if state == "over" {
        draw_rect(55, 88, 210, 72, "#000000")
        let l1 = "GAME OVER"
        let l2 = "final score: ${score}"
        let l3 = "press ENTER to restart"
        draw_text(l1, 160 - text_width(l1) / 2, 104, "#e74c3c")
        draw_text(l2, 160 - text_width(l2) / 2, 124, "#ffffff")
        draw_text(l3, 160 - text_width(l3) / 2, 144, "#95a5a6")
    }
}

fn menuDraw() {
    let t1 = "VOID RUNNER"
    let t2 = "endless space survival"
    let t3 = "PRESS ENTER TO START"
    draw_text(t1, 160 - text_width(t1) / 2, 70, "#ffffff")
    draw_text(t2, 160 - text_width(t2) / 2, 86, "#7fdbff")

    draw_text("A/D or arrows  move", 96, 118, "#aaaaaa")
    draw_text("SPACE  fire", 118, 132, "#aaaaaa")
    draw_text("P pause   M music", 104, 146, "#aaaaaa")

    if frame_t % 60 < 40 {
        draw_text(t3, 160 - text_width(t3) / 2, 184, "#f1c40f")
    }
}
