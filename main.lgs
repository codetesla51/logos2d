fn on_load() {
    print("game loaded")
}

let player = table{
    x: 40,
    y: 100,
}

// fixed target box to collide with
let target = table{
    x: 200,
    y: 90,
    w: 50,
    h: 60,
}

let hits = 0
let touching = false

fn on_update(dt) {
    if key_down("right") {
        player.x = player.x + 2
    }
    if key_down("left") {
        player.x = player.x - 2
    }
    if key_down("up") {
        player.y = player.y - 2
    }
    if key_down("down") {
        player.y = player.y + 2
    }

    // rects_overlap test: player is 24x24, target is target.w x target.h
    let now_touching = rects_overlap(player.x, player.y, 24, 24, target.x, target.y, target.w, target.h)
    if now_touching {
        if !touching {
            hits = hits + 1
            print("HIT #${hits} at player ${player.x},${player.y}")
        }
    }
    touching = now_touching

    let m = mouse_pos()
    if mouse_pressed("left") {
        print("click at ${m.x},${m.y}")
    }
}

fn on_draw() {
    // target box: green while overlapping, red while separate
    let c = "#e74c3c"
    if touching {
        c = "#2ecc71"
    }
    draw_rect(target.x, target.y, target.w, target.h, c)

    // player box
    draw_rect(player.x, player.y, 24, 24, "#3498db")

    // status readout
    draw_text("overlap: ${touching}  hits: ${hits}", 80, 12, "#ffffff")

    // point_in_rect test: is the mouse cursor inside the target box?
    let m = mouse_pos()
    let inside = point_in_rect(m.x, m.y, target.x, target.y, target.w, target.h)
    draw_text("mouse in box: ${inside}", 90, 28, "#f1c40f")

    // distance test: line from player center to target center + length label
    let d = distance(player.x + 12, player.y + 12, target.x + 25, target.y + 30)
    draw_line(player.x + 12, player.y + 12, target.x + 25, target.y + 30, "#9b59b6", 1)
    draw_text("dist: ${d}", (player.x + target.x) / 2 - 20, (player.y + target.y) / 2 - 10, "#bb86fc")

    draw_text("arrows to move into the box", 70, 228, "#aaaaaa")

    if mouse_down("left") {
        draw_circle(m.x, m.y, 5, "#ff00ff")
    }

    // sprite demos (kept from earlier tests)
    draw_sprite_ex("sprite.png", 290, 200, 1.0, 45)
}
