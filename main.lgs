// ============================================================
// GALAGA-STYLE DEFENSE — logos2d demo game
// Move: A/D or arrows   Fire: hold SPACE   Music: M   Quit: ESC
// Enemies rain from the top — don't let them reach the bottom!
// ============================================================

fn on_load() {
    preload_sprite("stars.png")
    preload_sprite("player.png")
    preload_sprite("enemy.png")
    preload_sprite("bullet.png")
    print("game loaded")
}

// ---------------- state ----------------

let px = 152.0        // player x (ship is 16 wide, screen 320)
let hp = 3
let score = 0
let kills = 0
let inv = 0           // invulnerability frames
let over = false
let frame_t = 0
let cooldown = 0      // fire rate limiter
let spawn_every = 80  // ticks between spawns (shrinks)

let bullets = []
let enemies = []

const W = 320
const H = 240

// ---------------- helpers ----------------

fn shoot() {
    if cooldown > 0 {
        return 0
    }
    let b = table{x: px + 8, y: 200.0}
    bullets = push(bullets, b)
    play_sound("shoot.wav")
    cooldown = 8
}

fn spawn_enemy() {
    let s = random(4, 11)
    let vx = random(-3, 3)
    let e = table{
        x: random(8, W - 24),
        y: -20,
        spd: s / 10.0,
        vx: vx / 10.0,
        hp: 1,
        ph: random(0, 100)
    }
    enemies = push(enemies, e)
}

fn reset_game() {
    px = 152.0
    hp = 3
    score = 0
    kills = 0
    inv = 0
    over = false
    cooldown = 0
    spawn_every = 80
    bullets = []
    enemies = []
}

// ---------------- update ----------------

fn on_update(dt) {
    frame_t = frame_t + 1

    if over {
        if key_pressed("enter") {
            reset_game()
        }
        return 0
    }

    // ---- move left/right ----
    if key_down("right") || key_down("d") {
        px = px + 3.0
    }
    if key_down("left") || key_down("a") {
        px = px - 3.0
    }
    if px < 0 { px = 0 }
    if px > W - 16 { px = W - 16 }

    // ---- continuous fire while holding space (or clicking) ----
    if cooldown > 0 {
        cooldown = cooldown - 1
    }
    if key_down("space") || mouse_down("left") {
        shoot()
    }

    // ---- music toggle ----
    if key_pressed("m") {
        play_music("music.wav")
    }

    // ---- bullets fly straight up ----
    let alive_bullets = []
    for b in bullets {
        b.y = b.y - 6
        if b.y > -20 {
            alive_bullets = push(alive_bullets, b)
        }
    }
    bullets = alive_bullets

    // ---- spawning speeds up as you kill ----
    if frame_t % spawn_every == 0 && !over {
        spawn_enemy()
        if kills > 0 && kills % 8 == 0 && spawn_every > 25 {
            spawn_every = spawn_every - 5
        }
    }

    // ---- enemies descend ----
    let alive_enemies = []
    for e in enemies {
        e.y = e.y + e.spd
        e.x = e.x + math_sin((frame_t + e.ph) / 18.0) * 0.4 + e.vx
        if e.x < 0 { e.x = 0 }
        if e.x > W - 16 { e.x = W - 16 }
        alive_enemies = push(alive_enemies, e)
    }
    enemies = alive_enemies

    // ---- bullet hits enemy (one shot one kill) ----
    for b in bullets {
        for e in enemies {
            if e.hp > 0 {
                if rects_overlap(b.x - 2, b.y - 8, 4, 14, e.x + 3, e.y + 3, 10, 10) {
                    e.hp = e.hp - 1
                    b.y = -100
                    score = score + 10
                    kills = kills + 1
                    play_sound("hit.wav")
                }
            }
        }
    }
    let survivors = []
    for e in enemies {
        if e.hp > 0 {
            survivors = push(survivors, e)
        }
    }
    enemies = survivors

    // ---- enemy reaches your line OR touches you -> hurt ----
    if inv > 0 {
        inv = inv - 1
    }
    let still_alive = []
    for e in enemies {
        let dead = false
        if e.y > H - 40 {
            dead = true
            score = score - 5
        }
        if inv == 0 {
            if rects_overlap(px, 204, 16, 16, e.x + 3, e.y + 3, 10, 10) {
                dead = true
                hp = hp - 1
                inv = 60
                play_sound("hurt.wav")
            }
        }
        if !dead {
            still_alive = push(still_alive, e)
        }
    }
    enemies = still_alive

    if hp <= 0 {
        over = true
        stop_music()
        print("GAME OVER - score ${score} - press ENTER to restart")
    }
}

// ---------------- draw ----------------

fn on_draw() {
    draw_sprite("stars.png", 0, 0)

    // enemies face down (sprites are drawn pointing up natively)
    for e in enemies {
        draw_sprite_ex("enemy.png", e.x + 9, e.y + 9, 0.22, 180)
    }

    // bullets (vertical bolt, flies up)
    for b in bullets {
        draw_sprite_ex("bullet.png", b.x, b.y, 0.3, 0)
    }

    // player ship at the bottom, blink while invulnerable
    if inv == 0 || frame_t % 8 < 5 {
        draw_sprite_ex("player.png", px + 8, 212, 0.22, 0)
    }

    // ------- HUD -------
    let hx = 270
    for i in range(0, hp, 1) {
        draw_circle(hx + i * 14 + 5, 12, 5, "#e74c3c")
    }
    draw_text("SCORE ${score}", 8, 6, "#ffffff")
    draw_text("kills: ${kills}", 8, 18, "#95a5a6")

    if over {
        draw_rect(70, 90, 180, 60, "#000000")
        draw_text("GAME OVER", 118, 108, "#e74c3c")
        draw_text("final score: ${score}", 105, 124, "#ffffff")
        draw_text("press ENTER to restart", 92, 138, "#95a5a6")
    }
}
