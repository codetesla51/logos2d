// ============================================================
// GALAGA DEFENSE — with menu, pause, shake, particles, glide
// Move: A/D or arrows   Fire: hold SPACE   Pause: P   Music: M
// ============================================================

fn on_load() {
    preload_sprite("background.png")
    preload_sprite("player.png")
    preload_sprite("enemy.png")
    preload_sprite("enemy_black.png")
    preload_sprite("enemy_blue.png")
    preload_sprite("enemy_green.png")
    preload_sprite("ufo.png")
    preload_sprite("meteor.png")
    preload_sprite("bullet.png")
    preload_sprite("laser_green.png")
    preload_sprite("laser_red.png")
    preload_sprite("shield.png")
    preload_sprite("pu_rapid.png")
    preload_sprite("pu_twin.png")
    preload_sprite("pu_shield.png")
    preload_sprite("pu_heart.png")
    play_music("music.mp3")
    print("game loaded")
}

// ---------------- state ----------------

let state = "menu"       // menu | play | pause | over

let px = 152.0
let pvx = 0.0            // player velocity (glide easing)
let hp = 3
let score = 0
let kills = 0
let inv = 0
let frame_t = 0
let cooldown = 0
let spawn_every = 80
let meteor_every = 210
let ufo_every = 540

let weapon = "blue"
let weapon_t = 0
let shield_t = 0
let music_on = true
let shake_t = 0          // screen shake frames remaining

let bullets = []
let enemies = []
let meteors = []
let powerups = []
let booms = []
let parts = []           // particles

const W = 320
const H = 240

// ---------------- helpers ----------------

fn start_game() {
    px = 152.0
    pvx = 0.0
    hp = 3
    score = 0
    kills = 0
    inv = 0
    cooldown = 0
    spawn_every = 80
    meteor_every = 210
    ufo_every = 540
    weapon = "blue"
    weapon_t = 0
    shield_t = 0
    shake_t = 0
    bullets = []
    enemies = []
    meteors = []
    powerups = []
    booms = []
    parts = []
    state = "play"
    play_music("music.mp3")
}

fn shoot() {
    if cooldown > 0 {
        return 0
    }
    let b1 = table{x: px + 8, y: 200.0, img: "bullet.png"}
    if weapon == "green" {
        b1.img = "laser_green.png"
        cooldown = 5
    }
    if weapon == "red" {
        b1.img = "laser_red.png"
        let b2 = table{x: px + 2, y: 200.0, img: "laser_red.png"}
        bullets = push(bullets, b2)
        cooldown = 9
    }
    if weapon == "blue" {
        cooldown = 8
    }
    bullets = push(bullets, b1)
    play_sound("shoot.wav")
}

fn spawn_enemy() {
    let roll = random(1, 10)
    let e = table{x: random(8, W - 26), y: -24, spd: 0.9, vx: 0.0, hp: 1, pts: 10, img: "enemy.png", ph: random(0, 100)}
    if roll <= 4 {
        e.spd = random(10, 14) / 10.0
        e.pts = 10
    }
    if roll >= 5 && roll <= 6 {
        e.img = "enemy_blue.png"
        e.spd = random(7, 9) / 10.0
        e.pts = 15
    }
    if roll == 7 || roll == 8 {
        e.img = "enemy_green.png"
        e.spd = random(5, 7) / 10.0
        e.vx = random(-15, 15) / 10.0
        e.pts = 15
    }
    if roll >= 9 {
        e.img = "enemy_black.png"
        e.spd = random(3, 5) / 10.0
        e.hp = 3
        e.pts = 40
    }
    enemies = push(enemies, e)
}

fn spawn_ufo() {
    let from_left = random(0, 1)
    let e = table{
        x: -30.0,
        y: random(30, 90),
        spd: 0.0,
        vx: 0.9,
        hp: 5,
        pts: 150,
        img: "ufo.png",
        ph: random(0, 100)
    }
    if from_left == 1 {
        e.x = W + 30
        e.vx = 0 - 0.9
    }
    enemies = push(enemies, e)
}

fn spawn_meteor() {
    let m = table{
        x: random(8, W - 30),
        y: -30,
        spd: random(3, 6) / 10.0,
        vx: random(-8, 8) / 10.0,
        rot: random(0, 359),
        vr: random(-3, 3),
        hp: 2
    }
    meteors = push(meteors, m)
}

fn boom(x, y) {
    let bfx = table{x: x, y: y, t: 0}
    booms = push(booms, bfx)
}

// particle burst: n sparks flying outward
fn burst(x, y, n, c) {
    for i in range(0, n, 1) {
        let ang = random(0, 359) * 3.14159 / 180.0
        let sp = random(6, 26) / 10.0
        let p = table{
            x: x,
            y: y,
            vx: math_cos(ang) * sp,
            vy: math_sin(ang) * sp,
            t: 0,
            c: c
        }
        parts = push(parts, p)
    }
}

fn drop_powerup(x, y) {
    if random(1, 10) > 3 {
        return 0
    }
    let roll = random(1, 4)
    let kind = "rapid"
    if roll == 2 {
        kind = "twin"
    }
    if roll == 3 {
        kind = "shield"
    }
    if roll == 4 {
        kind = "heart"
    }
    let pu = table{x: x, y: y, kind: kind}
    powerups = push(powerups, pu)
}

// ---------------- update ----------------

fn on_update(dt) {
    frame_t = frame_t + 1

    // music toggle works in any state
    if key_pressed("m") {
        if music_on {
            stop_music()
            music_on = false
        } else {
            play_music("music.mp3")
            music_on = true
        }
    }

    // ---- MENU ----
    if state == "menu" {
        if key_pressed("enter") || mouse_pressed("left") || key_pressed("space") {
            start_game()
        }
        return 0
    }

    // ---- PAUSE ----
    if state == "pause" {
        if key_pressed("p") {
            state = "play"
        }
        return 0
    }

    // ---- GAME OVER: wait for restart ----
    if state == "over" {
        if key_pressed("enter") {
            start_game()
            play_sound("powerup.wav")
        }
        return 0
    }

    // ================= PLAY =================

    // pause
    if key_pressed("p") {
        state = "pause"
        return 0
    }

    frameTick()

    movePlayer()

    // fire
    if cooldown > 0 {
        cooldown = cooldown - 1
    }
    if key_down("space") || mouse_down("left") {
        shoot()
    }

    // timers
    if inv > 0 { inv = inv - 1 }
    if weapon_t > 0 {
        weapon_t = weapon_t - 1
        if weapon_t == 0 && weapon != "blue" {
            weapon = "blue"
        }
    }
    if shield_t > 0 {
        shield_t = shield_t - 1
        if shield_t == 0 {
            play_sound("shield_down.wav")
        }
    }
    if shake_t > 0 {
        shake_t = shake_t - 1
    }

    updateBullets()
    updateSpawns()
    updateEnemies()
    updateMeteors()
    handleHits()
    updatePowerups()
    updateFx()

    if hp <= 0 {
        state = "over"
        stop_music()
        play_sound("lose.wav")
        print("GAME OVER - score ${score} - press ENTER to restart")
    }
}

fn frameTick() {
    // spawns
    if frame_t % spawn_every == 0 {
        spawn_enemy()
        if kills > 0 && kills % 8 == 0 && spawn_every > 25 {
            spawn_every = spawn_every - 5
        }
    }
    if frame_t % meteor_every == 0 {
        spawn_meteor()
    }
    if frame_t % ufo_every == 0 {
        spawn_ufo()
        ufo_every = 700 + random(0, 300)
    }
}

fn movePlayer() {
    // glide easing: accelerate toward input, friction when released
    let acc = 0.0
    if key_down("right") || key_down("d") {
        acc = acc + 0.55
    }
    if key_down("left") || key_down("a") {
        acc = acc - 0.55
    }
    pvx = pvx + acc
    if acc == 0.0 {
        pvx = pvx * 0.78
    }
    if pvx > 3.2 { pvx = 3.2 }
    if pvx < -3.2 { pvx = -3.2 }
    px = px + pvx
    if px < 0 { px = 0; pvx = 0 - pvx * 0.4 }
    if px > W - 16 { px = W - 16; pvx = 0 - pvx * 0.4 }
}

fn updateBullets() {
    let ab = []
    for b in bullets {
        b.y = b.y - 6
        if b.y > -20 {
            ab = push(ab, b)
        }
    }
    bullets = ab
}

fn updateSpawns() {
    if frame_t % spawn_every == 0 {
        spawn_enemy()
    }
}

fn updateEnemies() {
    let ae = []
    for e in enemies {
        if e.img == "ufo.png" {
            e.x = e.x + e.vx
            e.y = e.y + math_sin((frame_t + e.ph) / 24.0) * 0.4
            let offscreen = e.x < -40 || e.x > W + 40
            if !offscreen {
                ae = push(ae, e)
            }
        } else {
            e.y = e.y + e.spd
            e.x = e.x + math_sin((frame_t + e.ph) / 16.0) * 0.5 + e.vx
            if e.x < 0 { e.x = 0 }
            if e.x > W - 18 { e.x = W - 18 }
            ae = push(ae, e)
        }
    }
    enemies = ae
}

fn updateMeteors() {
    let am = []
    for m in meteors {
        m.y = m.y + m.spd
        m.x = m.x + m.vx
        m.rot = m.rot + m.vr
        if m.x < -10 || m.x > W + 10 {
            m.vx = 0 - m.vx
        }
        am = push(am, m)
    }
    meteors = am
}

fn handleHits() {
    // bullets vs enemies & meteors
    for b in bullets {
        for e in enemies {
            if e.hp > 0 {
                if rects_overlap(b.x - 2, b.y - 8, 4, 14, e.x + 1, e.y + 1, 16, 16) {
                    e.hp = e.hp - 1
                    b.y = -100
                    if e.hp <= 0 {
                        score = score + e.pts
                        kills = kills + 1
                        boom(e.x + 9, e.y + 9)
                        burst(e.x + 9, e.y + 9, 8, "#e67e22")
                        play_sound("explosion.wav")
                        drop_powerup(e.x + 9, e.y)
                    }
                }
            }
        }
        for m in meteors {
            if m.hp > 0 {
                if rects_overlap(b.x - 2, b.y - 8, 4, 14, m.x + 1, m.y + 1, 18, 18) {
                    m.hp = m.hp - 1
                    b.y = -100
                    if m.hp <= 0 {
                        score = score + 20
                        kills = kills + 1
                        boom(m.x + 10, m.y + 10)
                        burst(m.x + 10, m.y + 10, 10, "#a07050")
                        play_sound("explosion.wav")
                    }
                }
            }
        }
    }

    let se = []
    for e in enemies {
        if e.hp > 0 {
            se = push(se, e)
        }
    }
    enemies = se
    let sm = []
    for m in meteors {
        if m.hp > 0 {
            sm = push(sm, m)
        }
    }
    meteors = sm

    // reach your line or touch you
    let keep_e = []
    for e in enemies {
        let gone = false
        if e.img != "ufo.png" {
            if e.y > H - 20 {
                gone = true
                if score >= 5 {
                    score = score - 5
                }
            }
        }
        if rects_overlap(px + 4, 206, 8, 12, e.x + 1, e.y + 1, 16, 16) {
            gone = true
            boom(e.x + 9, e.y + 9)
            burst(e.x + 9, e.y + 9, 8, "#e74c3c")
            if shield_t == 0 {
                hp = hp - 1
                inv = 60
                shake_t = 14
                play_sound("hurt.wav")
            }
        }
        if !gone {
            keep_e = push(keep_e, e)
        }
    }
    enemies = keep_e

    let keep_m = []
    for m in meteors {
        let gone = false
        if m.y > H - 20 {
            gone = true
        }
        if rects_overlap(px + 4, 206, 8, 12, m.x + 1, m.y + 1, 18, 18) {
            gone = true
            boom(m.x + 10, m.y + 10)
            burst(m.x + 10, m.y + 10, 10, "#a07050")
            play_sound("explosion.wav")
            if shield_t == 0 {
                hp = hp - 1
                inv = 60
                shake_t = 14
                play_sound("hurt.wav")
            }
        }
        if !gone {
            keep_m = push(keep_m, m)
        }
    }
    meteors = keep_m
}

fn updatePowerups() {
    let ap = []
    for pu in powerups {
        pu.y = pu.y + 1.2
        let caught = rects_overlap(px + 1, 203, 14, 18, pu.x - 5, pu.y - 5, 10, 10)
        if caught {
            play_sound("powerup.wav")
            burst(pu.x, pu.y, 6, "#ff6b81")
            if pu.kind == "rapid" {
                weapon = "green"
                weapon_t = 600
            }
            if pu.kind == "twin" {
                weapon = "red"
                weapon_t = 600
            }
            if pu.kind == "shield" {
                shield_t = 360
                play_sound("shield_up.wav")
            }
            if pu.kind == "heart" {
                if hp < 3 {
                    hp = hp + 1
                }
                score = score + 25
            }
        }
        if pu.y < H - 24 && !caught {
            ap = push(ap, pu)
        }
    }
    powerups = ap
}

fn updateFx() {
    let abo = []
    for bx in booms {
        bx.t = bx.t + 1
        if bx.t < 16 {
            abo = push(abo, bx)
        }
    }
    booms = abo

    let apt = []
    for p in parts {
        p.x = p.x + p.vx
        p.y = p.y + p.vy
        p.t = p.t + 1
        if p.t < 20 {
            apt = push(apt, p)
        }
    }
    parts = apt
}

// ---------------- draw ----------------

fn on_draw() {
    // screen shake: world layer drawn through a jittering camera
    set_camera(math_sin(frame_t * 93.0) * shake_t * 0.6, math_cos(frame_t * 71.0) * shake_t * 0.6)

    draw_sprite("background.png", 0, 0)

    if state == "menu" {
        menuDraw()
        return 0
    }

    for m in meteors {
        draw_sprite_ex("meteor.png", m.x + 10, m.y + 10, 0.45, m.rot)
    }

    for e in enemies {
        draw_sprite_ex(e.img, e.x + 9, e.y + 9, 0.22, 180)
    }

    for pu in powerups {
        let pimg = "pu_rapid.png"
        if pu.kind == "twin" {
            pimg = "pu_twin.png"
        }
        if pu.kind == "shield" {
            pimg = "pu_shield.png"
        }
        if pu.kind == "heart" {
            pimg = "pu_heart.png"
        }
        // gentle bob
        draw_sprite_ex(pimg, pu.x, pu.y + math_sin(frame_t / 9.0 + pu.x) * 2.0, 0.45, 0)
    }

    for b in bullets {
        draw_sprite_ex(b.img, b.x, b.y, 0.3, 0)
    }

    if inv == 0 || frame_t % 8 < 5 {
        draw_sprite_ex("player.png", px + 8, 212, 0.22, 0)
    }
    if cooldown > 5 {
        draw_circle(px + 8, 200, 2, "#f1c40f")
    }
    if shield_t > 0 {
        draw_sprite_ex("shield.png", px + 8, 212, 0.22, 0)
    }

    // explosion rings
    for bx in booms {
        let r = bx.t
        draw_circle(bx.x, bx.y, r, "#e67e22")
        draw_circle(bx.x, bx.y, r / 2, "#f1c40f")
        if bx.t > 8 {
            draw_circle(bx.x, bx.y, r / 3, "#ffffff")
        }
    }

    // particles (shrink as they die)
    for p in parts {
        let r = (20 - p.t) / 7
        draw_circle(p.x, p.y, r + 1, p.c)
    }

    // ------- HUD: back to steady camera -------
    set_camera(0, 0)

    for i in range(0, hp, 1) {
        draw_sprite_ex("life_icon.png", 266 + i * 17, 13, 0.42, 0)
    }
    draw_text("SCORE ${score}", 8, 24, "#ffffff")
    draw_text("kills: ${kills}", 8, 38, "#aaaaaa")

    let wx = 312
    if weapon == "green" {
        let l = "RAPID ${weapon_t / 60}"
        draw_text(l, wx - text_width(l), 26, "#2ecc71")
    }
    if weapon == "red" {
        let l = "TWIN ${weapon_t / 60}"
        draw_text(l, wx - text_width(l), 26, "#e74c3c")
    }
    if shield_t > 0 {
        let l = "SHLD ${shield_t / 60}"
        draw_text(l, wx - text_width(l), 40, "#3498db")
    }

    if state == "pause" {
        draw_rect(85, 100, 150, 44, "#000000")
        let l = "PAUSED"
        draw_text(l, 160 - text_width(l) / 2, 116, "#ffffff")
        let l2 = "press P to resume"
        draw_text(l2, 160 - text_width(l2) / 2, 132, "#95a5a6")
    }

    if state == "over" {
        draw_rect(55, 88, 210, 72, "#000000")
        let l1 = "GAME OVER"
        let l2 = "final score: ${score}"
        let l3 = "press ENTER to restart"
        draw_text(l1, 160 - text_width(l1) / 2, 104, "#e74c3c")
        draw_text(l2, 160 - text_width(l2) / 2, 124, "#ffffff")
        draw_text(l3, 160 - text_width(l3) / 2, 144, "#95a5a6")
    }
}

fn menuDraw() {
    let t1 = "GALAGA DEFENSE"
    let t2 = "a logos2d game"
    let t3 = "PRESS ENTER TO START"
    draw_text(t1, 160 - text_width(t1) / 2, 70, "#ffffff")
    draw_text(t2, 160 - text_width(t2) / 2, 86, "#7fdbff")

    draw_text("A/D or arrows  move", 96, 120, "#aaaaaa")
    draw_text("SPACE  fire", 118, 134, "#aaaaaa")
    draw_text("P pause   M music", 104, 148, "#aaaaaa")

    if frame_t % 60 < 40 {
        draw_text(t3, 160 - text_width(t3) / 2, 186, "#f1c40f")
    }
}
